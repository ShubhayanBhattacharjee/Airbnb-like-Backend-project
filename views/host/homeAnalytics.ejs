<%- include('../partials/header', { pageTitle: pageTitle }) %>
<link rel="stylesheet" href="/css/host/homeAnalytics.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.2.0/remixicon.min.css">
</head>
<body class="analytics-body">
<%- include('../partials/navbar') %>

<main class="analytics-page">

  <section class="analytics-hero">
    <p class="hero-mini">LISTING ANALYTICS</p>
    <h1><%= home.houseName %></h1>
    <p class="hero-description">Performance over time for this listing.</p>
  </section>

  <section class="analytics-section">

    <div class="stats-grid">
      <div class="stat-card">
        <p class="stat-label">Total Revenue</p>
        <p class="stat-value stat-value--revenue">₹<%= totalRevenue.toLocaleString('en-IN') %></p>
      </div>
      <div class="stat-card">
        <p class="stat-label">Total Bookings</p>
        <p class="stat-value"><%= totalBookings %></p>
      </div>
      <div class="stat-card">
        <p class="stat-label">Upcoming / Completed</p>
        <p class="stat-value"><%= upcomingCount %> / <%= completedCount %></p>
      </div>
      <div class="stat-card">
        <p class="stat-label">Rating</p>
        <p class="stat-value">
          <%= home.avgRating || '—' %>
          <% if (home.avgRating) { %><span class="stat-rating-star">★</span><% } %>
        </p>
        <p class="stat-subtext"><%= home.reviewCount %> review<%= home.reviewCount !== 1 ? 's' : '' %></p>
      </div>
    </div>
    <div class="stats-grid stats-grid--secondary">
      <div class="stat-card">
        <p class="stat-label">Avg. Nightly Rate</p>
        <p class="stat-value">₹<%= avgNightlyRate.toLocaleString('en-IN') %></p>
      </div>
      <div class="stat-card">
        <p class="stat-label">Avg. Length of Stay</p>
        <p class="stat-value"><%= avgLengthOfStay %> <span class="stat-unit">night<%= avgLengthOfStay !== 1 ? 's' : '' %></span></p>
      </div>
      <div class="stat-card">
        <p class="stat-label">Avg. Booking Lead Time</p>
        <p class="stat-value"><%= avgLeadTimeDays %> <span class="stat-unit">day<%= avgLeadTimeDays !== 1 ? 's' : '' %></span></p>
      </div>
      <div class="stat-card">
        <p class="stat-label">Repeat Guests</p>
        <p class="stat-value"><%= repeatGuestCount %></p>
      </div>
      <div class="stat-card">
        <p class="stat-label">Cancellation Rate</p>
        <p class="stat-value <%= cancellationRate > 20 ? 'stat-value--warn' : '' %>"><%= cancellationRate %>%</p>
      </div>
    </div>
    <% if (bestMonth) { %>
      <div class="callout-row">
        <div class="callout-chip callout-chip--good">
          <i class="ri-arrow-up-line"></i>
          <span>Best month: <strong><%= bestMonth.label %></strong> · ₹<%= bestMonth.revenue.toLocaleString('en-IN') %></span>
        </div>
        <% if (worstMonth && worstMonth.label !== bestMonth.label) { %>
          <div class="callout-chip callout-chip--muted">
            <i class="ri-arrow-down-line"></i>
            <span>Slowest month: <strong><%= worstMonth.label %></strong> · ₹<%= worstMonth.revenue.toLocaleString('en-IN') %></span>
          </div>
        <% } %>
      </div>
    <% } %>
    <div class="charts-grid">

      <div class="chart-card">
        <h2>Bookings & Revenue — Last 6 Months</h2>
        <% if (monthlyData.length === 0) { %>
          <p class="chart-empty">No booking data yet for this listing.</p>
        <% } else { %>
          <% const maxBookings = Math.max(...monthlyData.map(m => m.bookings)); %>
          <% monthlyData.forEach(m => { %>
            <% const barWidth = maxBookings > 0 ? Math.round((m.bookings / maxBookings) * 100) : 0; %>
            <div class="chart-row">
              <div class="chart-row-header">
                <span><%= m.label %></span>
                <span><%= m.bookings %> booking<%= m.bookings !== 1 ? 's' : '' %> · ₹<%= m.revenue.toLocaleString('en-IN') %></span>
              </div>
              <div class="chart-bar-track">
                <div class="chart-bar-fill" data-width="<%= barWidth %>"></div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
      <div class="chart-card">
        <h2>Occupancy Rate — Last 6 Months</h2>
        <% occupancyData.forEach(o => { %>
          <div class="chart-row">
            <div class="chart-row-header">
              <span><%= o.label %></span>
              <span><%= o.occupancyPercent %>% booked</span>
            </div>
            <div class="chart-bar-track">
              <div class="chart-bar-fill chart-bar-fill--gold" data-width="<%= o.occupancyPercent %>"></div>
            </div>
          </div>
        <% }) %>
        <p class="chart-note">Based on nights booked ÷ days in each month.</p>
      </div>
      <div class="chart-card">
        <h2>Weekday vs Weekend Nights</h2>
        <div class="split-bar">
          <div class="split-bar-fill split-bar-fill--weekday" style="width: <%= weekdayShare %>%;"></div>
          <div class="split-bar-fill split-bar-fill--weekend" style="width: <%= weekendShare %>%;"></div>
        </div>
        <div class="split-legend">
          <span><i class="legend-dot legend-dot--weekday"></i> Weekday · <%= weekdayShare %>%</span>
          <span><i class="legend-dot legend-dot--weekend"></i> Weekend · <%= weekendShare %>%</span>
        </div>
      </div>
      <div class="chart-card">
        <h2>Rating Trend — Last 6 Months</h2>
        <% if (ratingTrend.length === 0) { %>
          <p class="chart-empty">No reviews yet in this period.</p>
        <% } else { %>
          <% ratingTrend.forEach(r => { %>
            <div class="chart-row">
              <div class="chart-row-header">
                <span><%= r.label %></span>
                <span><%= r.avgRating %> ★ · <%= r.count %> review<%= r.count !== 1 ? 's' : '' %></span>
              </div>
              <div class="chart-bar-track">
                <div class="chart-bar-fill chart-bar-fill--rating" data-width="<%= Math.round((r.avgRating / 5) * 100) %>"></div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </section>
</main>
<%- include('../partials/footer') %>
<script>
  document.querySelectorAll('[data-width]').forEach(el => {
    el.style.width = el.dataset.width + '%';
  });
</script>
</body>
</html>