<%- include('../partials/header', { pageTitle: editing ? "Edit Home" : "Add Your Home" }) %>
<link rel="stylesheet" href="/css/host/editHome.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.2.0/remixicon.min.css">
</head>

<body class="add-home-body" data-editing="<%= editing ? 'true' : 'false' %>">
<%- include('../partials/navbar') %>

<% const homeTypeMeta = {
    beach:       { label: 'Beach',       icon: 'ri-sun-line' },
    mountain:    { label: 'Mountain',    icon: 'ri-landscape-line' },
    forest:      { label: 'Forest',      icon: 'ri-plant-line' },
    lake:        { label: 'Lake',        icon: 'ri-drop-line' },
    countryside: { label: 'Countryside', icon: 'ri-leaf-line' },
    city:        { label: 'City',        icon: 'ri-building-4-line' },
    desert:      { label: 'Desert',      icon: 'ri-sun-foggy-line' },
    farm:        { label: 'Farm',        icon: 'ri-seedling-line' },
    cabin:       { label: 'Cabin',       icon: 'ri-snowy-line' },
    island:      { label: 'Island',      icon: 'ri-compass-3-line' }
  }; %>
<% const typeList = (typeof homeTypes !== 'undefined' && homeTypes.length) ? homeTypes : Object.keys(homeTypeMeta); %>
<% const selectedHomeType = editing && home.homeType ? home.homeType : 'city'; %>

<main class="add-home-page">
  <aside class="add-home-aside">
    <div class="aside-inner">
      <p class="aside-mini"><%= editing ? "MANAGE LISTING" : "HOST WITH US" %></p>
      <h1><%= editing ? "Edit your home" : "List your home" %></h1>
      <p class="aside-sub">
        <%= editing
          ? "Update your listing details. Changes go live immediately for guests browsing your property."
          : "Share your space with guests from around the world. Fill in the details below to get started." %>
      </p>

      <div class="aside-steps" id="asideSteps">
        <div class="step active" data-step="1">
          <span class="step-num">1</span>
          <div>
            <p class="step-title">Property details</p>
            <p class="step-desc">Name, address, type, amenities</p>
          </div>
        </div>
        <div class="step" data-step="2">
          <span class="step-num">2</span>
          <div>
            <p class="step-title">Photos & description</p>
            <p class="step-desc">Show guests what to expect</p>
          </div>
        </div>
        <div class="step" data-step="3">
          <span class="step-num">3</span>
          <div>
            <p class="step-title">Pricing & confirm</p>
            <p class="step-desc">Set your rate and publish</p>
          </div>
        </div>
      </div>

      <div class="aside-note">
        <i class="ri-shield-check-line"></i>
        <p>Your listing is protected by HomeStay's host guarantee.</p>
      </div>
    </div>
  </aside>

  <section class="add-home-form-section">
    <div class="form-card">
      <div class="form-card-header">
        <h2><%= editing ? "Update listing" : "New listing" %></h2>
        <p>All fields marked <span class="required-star">*</span> are required.</p>
      </div>
      <form
        action="/host/<%= editing ? `editHome/${home._id}` : 'addHome' %>"
        method="POST"
        enctype="multipart/form-data"
        class="add-home-form"
        id="addHomeForm"
      >
      <input
          type="hidden"
          name="_csrf"
          value="<%= csrfToken %>"
      >

        <input type="hidden" name="id" value="<%= editing ? home._id : '' %>">
        <div class="form-step active" data-step="1">
          <p class="step-progress">Step 1 of 3 — Property details</p>
          <div class="field-group">
            <label for="houseName">
              <i class="ri-home-3-line"></i>
              House name <span class="required-star">*</span>
            </label>
            <input
              type="text"
              id="houseName"
              name="houseName"
              placeholder="e.g. Cliffside Villa, The Birch Cabin"
              value="<%= editing ? home.houseName : '' %>"
              required
            >
          </div>

          <div class="field-group">
            <label for="addressLine1">
              <i class="ri-home-3-line"></i>
              Building / House no., Street <span class="required-star">*</span>
            </label>
            <input
              type="text" id="addressLine1" name="addressLine1"
              placeholder="e.g. 221B, MG Road"
              value="<%= editing ? home.addressLine1 : '' %>"
              required
            >
          </div>

          <div class="field-group">
            <label for="addressLine2">
              <i class="ri-community-line"></i>
              Locality / Area <span style="font-weight:400;color:var(--text-faint);text-transform:none;letter-spacing:normal;font-family:'Inter',sans-serif;">(optional)</span>
            </label>
            <input
              type="text" id="addressLine2" name="addressLine2"
              placeholder="e.g. Near Raja's Seat"
              value="<%= editing ? (home.addressLine2 || '') : '' %>"
            >
          </div>

          <div class="field-row field-row-3">
            <div class="field-group">
              <label for="city"><i class="ri-building-4-line"></i> City <span class="required-star">*</span></label>
              <input type="text" id="city" name="city" placeholder="e.g. Coorg"
                value="<%= editing ? home.city : '' %>" required>
            </div>
            <div class="field-group">
              <label for="state"><i class="ri-map-2-line"></i> State <span class="required-star">*</span></label>
              <input type="text" id="state" name="state" placeholder="e.g. Karnataka"
                value="<%= editing ? home.state : '' %>" required>
            </div>
            <div class="field-group">
              <label for="pincode"><i class="ri-navigation-line"></i> Pincode <span class="required-star">*</span></label>
              <input type="text" id="pincode" name="pincode" placeholder="e.g. 571201"
                pattern="[0-9]{6}" title="6-digit pincode"
                value="<%= editing ? home.pincode : '' %>" required>
            </div>
          </div>

          <div class="field-group">
            <label for="country"><i class="ri-earth-line"></i> Country <span class="required-star">*</span></label>
            <input type="text" id="country" name="country" placeholder="e.g. India"
              value="<%= editing ? (home.country || 'India') : 'India' %>" required>
          </div>

          <div class="field-group">
            <label for="no_of_bedRooms">
              <i class="ri-hotel-bed-line"></i>
              Bedrooms <span class="required-star">*</span>
            </label>
            <div class="number-input-wrap">
              <input type="number" id="bedrooms" name="no_of_bedRooms" min="1" required>
              <div class="spin-btns">
                <button type="button" class="spin-btn spin-up" onclick="stepInput('bedrooms', 1)"></button>
                <button type="button" class="spin-btn spin-down" onclick="stepInput('bedrooms', -1)"></button>
              </div>
            </div>
          </div>

          <div class="field-group">
            <label><i class="ri-map-pin-2-line"></i> What kind of place is it? <span class="required-star">*</span></label>
            <div class="home-type-grid" id="homeTypeGrid">
              <% typeList.forEach(function(type){ %>
                <% const meta = homeTypeMeta[type] || { label: type, icon: 'ri-home-4-line' }; %>
                <label class="home-type-option <%= type === selectedHomeType ? 'selected' : '' %>">
                  <input
                    type="radio"
                    name="homeType"
                    value="<%= type %>"
                    <%= type === selectedHomeType ? "checked" : "" %>
                    required
                  >
                  <i class="<%= meta.icon %>"></i>
                  <span><%= meta.label %></span>
                </label>
              <% }); %>
            </div>
          </div>

          <div class="field-group">
            <label><i class="ri-checkbox-multiple-line"></i> Amenities</label>
            <div class="amenities-grid" id="amenitiesGrid">
              <% const presetAmenities = ["WiFi","Kitchen","Free parking","Pool","Air conditioning",
                  "Washer","TV","Heating","Dedicated workspace","Pet friendly"]; %>
              <% presetAmenities.forEach(function(item){ %>
                <label class="amenity-option">
                  <input
                    type="checkbox"
                    name="amenities"
                    value="<%= item %>"
                    <%= (editing && home.amenities && home.amenities.includes(item)) ? "checked" : "" %>
                  >
                  <%= item %>
                </label>
              <% }); %>
              <% if (editing && home.amenities) { %>
                <% home.amenities.filter(a => !presetAmenities.includes(a)).forEach(function(item){ %>
                  <label class="amenity-option amenity-option-custom">
                    <input type="checkbox" name="amenities" value="<%= item %>" checked>
                    <%= item %>
                  </label>
                <% }); %>
              <% } %>
            </div>

            <div class="custom-amenity-row">
              <input
                type="text"
                id="customAmenityInput"
                placeholder="Don't see it? Add your own, e.g. Rooftop terrace"
                maxlength="40"
              >
              <button type="button" id="addCustomAmenityBtn" class="btn-add-amenity">
                <i class="ri-add-line"></i> Add
              </button>
            </div>
          </div>

          <div class="form-actions">
            <a href="/host/hostHomeList" class="btn-cancel">
              <i class="ri-arrow-left-line"></i>
              Back to listings
            </a>
            <button type="button" class="btn-submit btn-next" data-next="2">
              Next: Photos & description
              <i class="ri-arrow-right-line"></i>
            </button>
          </div>
        </div>

        <div class="form-step" data-step="2">
          <p class="step-progress">Step 2 of 3 — Photos & description</p>
          <div class="field-group">
            <label for="photo">
              <i class="ri-image-line"></i>
              Property photos <% if (!editing) { %><span class="required-star">*</span><% } %>
            </label>
            <% if (editing && home.photos && home.photos.length > 0) { %>
              <p class="upload-hint" style="margin-bottom:.6rem;">
                Click × to remove a photo. 
              </p>
              <div class="photo-preview-grid" id="existingPhotoGrid" style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px;">
                <% home.photos.forEach(url => { %>
                  <div class="existing-photo-item" style="position:relative;width:72px;height:72px;">
                    <img src="<%= url %>" style="width:100%;height:100%;object-fit:cover;border:1px solid rgba(255,255,255,.15);">
                    <button type="button" class="remove-existing-photo" title="Remove"
                      style="position:absolute;top:-6px;right:-6px;width:20px;height:20px;border-radius:50%;background:#FF5C5C;color:#fff;border:none;cursor:pointer;font-size:12px;line-height:1;">×</button>
                    <input type="hidden" name="existingPhotos" value="<%= url %>">
                  </div>
                <% }) %>
              </div>
            <% } %>
            <div class="file-upload-area" id="uploadArea">
              <i class="ri-upload-cloud-2-line upload-icon"></i>
              <p class="upload-text">
                <% if (editing) { %>
                  Upload new photos to add to the listing
                <% } else { %>
                  Drag & drop or <span class="upload-link">click to browse</span> — hold Ctrl/Cmd to pick several, or click again to add more
                <% } %>
              </p>
              <p class="upload-hint">JPG or PNG, max 5 MB each, up to 8 photos</p>
              <input type="file" id="photo" name="photos" multiple accept="image/jpg,image/jpeg,image/png" <%= editing ? "" : "required" %>>
            </div>
            <div class="photo-preview-grid" id="photoPreviewGrid" style="display:flex;gap:10px;flex-wrap:wrap;margin-top:12px;"></div>
            <p class="file-name-display" id="fileName"></p>
          </div>

          <div class="field-group">
            <label for="description">
              <i class="ri-file-text-line"></i>
              Description <span class="required-star">*</span>
            </label>
            <textarea
              id="description"
              name="description"
              rows="5"
              placeholder="Describe the home, its surroundings, what makes it special…"
              required
            ><%= editing ? home.description : '' %></textarea>
          </div>

          <div class="form-actions">
            <button type="button" class="btn-cancel btn-back" data-back="1">
              <i class="ri-arrow-left-line"></i>
              Back
            </button>
            <button type="button" class="btn-submit btn-next" data-next="3">
              Next: Pricing
              <i class="ri-arrow-right-line"></i>
            </button>
          </div>
        </div>

        <div class="form-step" data-step="3">
          <p class="step-progress">Step 3 of 3 — Pricing & confirm</p>

          <div class="field-group">
            <label for="price">
              <i class="ri-money-rupee-circle-line"></i>
              Price per night <span class="required-star">*</span>
            </label>
            <div class="input-prefix-wrap">
              <span class="input-prefix">₹</span>
              <input
                type="number"
                id="price"
                name="price"
                placeholder="3500"
                value="<%= editing ? home.price : '' %>"
                min="1"
                required
              >
            </div>
          </div>

          <div class="field-row">
            <div class="field-group">
              <label for="maxGuests"><i class="ri-group-line"></i> Max guests</label>
              <input
                type="number"
                id="maxGuests"
                name="maxGuests"
                min="1" max="20"
                value="<%= editing ? home.maxGuests : 2 %>"
                required
              >
            </div>
            <div class="field-group">
              <label for="cancellationPolicy"><i class="ri-file-shield-2-line"></i> Cancellation policy</label>
              <select id="cancellationPolicy" name="cancellationPolicy" required>
                <% ["flexible","moderate","strict"].forEach(function(policy){ %>
                  <option value="<%= policy %>"
                    <%= (editing && home.cancellationPolicy === policy) ? "selected" : (!editing && policy === "moderate" ? "selected" : "") %>
                  ><%= policy.charAt(0).toUpperCase() + policy.slice(1) %></option>
                <% }); %>
              </select>
            </div>
          </div>

          <div class="field-row">
            <div class="field-group">
              <label for="checkInTime"><i class="ri-login-box-line"></i> Check-in time</label>
              <input type="time" id="checkInTime" name="checkInTime"
                value="<%= editing ? home.checkInTime : '14:00' %>" required>
            </div>
            <div class="field-group">
              <label for="checkOutTime"><i class="ri-logout-box-line"></i> Check-out time</label>
              <input type="time" id="checkOutTime" name="checkOutTime"
                value="<%= editing ? home.checkOutTime : '11:00' %>" required>
            </div>
          </div>

          <div class="form-actions">
            <button type="button" class="btn-cancel btn-back" data-back="2">
              <i class="ri-arrow-left-line"></i>
              Back
            </button>
            <button type="submit" class="btn-submit">
              <i class="<%= editing ? 'ri-save-line' : 'ri-add-circle-line' %>"></i>
              <%= editing ? "Save changes" : "Add listing" %>
            </button>
          </div>
        </div>

      </form>
    </div>
  </section>

</main>
<script>
  const photoInput   = document.getElementById('photo');
  const fileNameEl   = document.getElementById('fileName');
  const uploadArea    = document.getElementById('uploadArea');
  const previewGrid   = document.getElementById('photoPreviewGrid');
  const existingGrid  = document.getElementById('existingPhotoGrid');
  const MAX_PHOTOS   = 8;

  let selectedFiles = [];

  function syncInputFiles() {
    const dt = new DataTransfer();
    selectedFiles.forEach(file => dt.items.add(file));
    photoInput.files = dt.files;
  }

  function updateFileNameText() {
    if (selectedFiles.length === 0) {
      fileNameEl.textContent = '';
      uploadArea.classList.remove('has-file');
    } else {
      fileNameEl.textContent = selectedFiles.length === 1
        ? selectedFiles[0].name
        : `${selectedFiles.length} photos selected`;
      uploadArea.classList.add('has-file');
    }
  }

  function renderPreviews() {
    previewGrid.innerHTML = '';
    selectedFiles.forEach((file, index) => {
      const url = URL.createObjectURL(file);
      const wrapper = document.createElement('div');
      wrapper.style.cssText = 'position:relative;width:72px;height:72px;';
      wrapper.innerHTML = `
        <img src="${url}" style="width:100%;height:100%;object-fit:cover;border:1px solid rgba(255,255,255,.15);">
        <button type="button" data-index="${index}" title="Remove"
          style="position:absolute;top:-6px;right:-6px;width:20px;height:20px;border-radius:50%;background:#FF5C5C;color:#fff;border:none;cursor:pointer;font-size:12px;line-height:1;">×</button>
      `;
      previewGrid.appendChild(wrapper);
    });

    previewGrid.querySelectorAll('button').forEach(btn => {
      btn.addEventListener('click', () => {
        selectedFiles.splice(Number(btn.dataset.index), 1);
        syncInputFiles();
        renderPreviews();
        updateFileNameText();
      });
    });
  }

  if (existingGrid) {
    existingGrid.addEventListener('click', (e) => {
      const btn = e.target.closest('.remove-existing-photo');
      if (!btn) return;
      btn.closest('.existing-photo-item').remove();
    });
  }

  function addFiles(newFiles) {
    for (const file of newFiles) {
      if (selectedFiles.length >= MAX_PHOTOS) break;
      selectedFiles.push(file);
    }
    syncInputFiles();
    renderPreviews();
    updateFileNameText();
  }

  photoInput.addEventListener('change', () => {
    addFiles(Array.from(photoInput.files));
  });

  uploadArea.addEventListener('click', () => photoInput.click());

  uploadArea.addEventListener('dragover', e => {
    e.preventDefault();
    uploadArea.classList.add('drag-over');
  });
  uploadArea.addEventListener('dragleave', () => uploadArea.classList.remove('drag-over'));
  uploadArea.addEventListener('drop', e => {
    e.preventDefault();
    uploadArea.classList.remove('drag-over');
    if (e.dataTransfer.files.length) {
      addFiles(Array.from(e.dataTransfer.files));
    }
  });

  const homeTypeGrid = document.getElementById('homeTypeGrid');
  if (homeTypeGrid) {
    homeTypeGrid.addEventListener('change', (e) => {
      if (e.target.name !== 'homeType') return;
      homeTypeGrid.querySelectorAll('.home-type-option').forEach(opt => {
        opt.classList.toggle('selected', opt.contains(e.target) && e.target.checked);
      });
    });
  }
  const amenitiesGrid       = document.getElementById('amenitiesGrid');
  const customAmenityInput  = document.getElementById('customAmenityInput');
  const addCustomAmenityBtn = document.getElementById('addCustomAmenityBtn');

  function addCustomAmenity() {
    const value = customAmenityInput.value.trim();
    if (!value) return;

    const alreadyExists = Array.from(amenitiesGrid.querySelectorAll('input[name="amenities"]'))
      .some(input => input.value.toLowerCase() === value.toLowerCase());
    if (alreadyExists) {
      customAmenityInput.value = '';
      return;
    }

    const label = document.createElement('label');
    label.className = 'amenity-option amenity-option-custom';
    label.innerHTML = `
      <input type="checkbox" name="amenities" value="${value.replace(/"/g, '&quot;')}" checked>
      ${value}
      <button type="button" class="remove-custom-amenity" title="Remove">×</button>
    `;
    amenitiesGrid.appendChild(label);
    customAmenityInput.value = '';
    customAmenityInput.focus();
  }

  addCustomAmenityBtn.addEventListener('click', addCustomAmenity);
  customAmenityInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      addCustomAmenity();
    }
  });
  amenitiesGrid.addEventListener('click', (e) => {
    const removeBtn = e.target.closest('.remove-custom-amenity');
    if (!removeBtn) return;
    removeBtn.closest('.amenity-option-custom').remove();
  });

  const isEditing =document.body.dataset.editing === "true";
  const formSteps      = Array.from(document.querySelectorAll('.form-step'));
  const sidebarSteps   = Array.from(document.querySelectorAll('#asideSteps .step'));
  let currentStep     = 1;
  let maxStepReached   = 1;

  function stepEl(n) {
    return document.querySelector(`.form-step[data-step="${n}"]`);
  }

  function validateStep(n) {
    const el = stepEl(n);
    const fields = el.querySelectorAll('input, select, textarea');
    for (const field of fields) {
      if (!field.checkValidity()) {
        field.reportValidity();
        return false;
      }
    }
    if (n === 2 && isEditing) {
      const keptCount = document.querySelectorAll('#existingPhotoGrid .existing-photo-item').length;
      if (keptCount + selectedFiles.length === 0) {
        alert('Please keep at least one photo or upload a new one.');
        return false;
      }
    }
    return true;
  }

  function renderSidebar() {
    sidebarSteps.forEach(s => {
      const n = Number(s.dataset.step);
      s.classList.remove('active', 'completed', 'reachable');
      if (n === currentStep) s.classList.add('active');
      if (n < currentStep || n < maxStepReached) s.classList.add('completed');
      if (n <= maxStepReached) s.classList.add('reachable');

      const numEl = s.querySelector('.step-num');
      if (n < maxStepReached && n !== currentStep) {
        numEl.innerHTML = '<i class="ri-check-line"></i>';
      } else {
        numEl.textContent = n;
      }
    });
  }

  function goToStep(n) {
    formSteps.forEach(el => el.classList.toggle('active', Number(el.dataset.step) === n));
    currentStep = n;
    if (n > maxStepReached) maxStepReached = n;
    renderSidebar();
    const formCard = document.querySelector('.form-card');
    const offset = 110; // adjust to your navbar height

    window.scrollTo({
        top: formCard.getBoundingClientRect().top + window.pageYOffset - offset,
        behavior: 'smooth'
    });
  }

  document.querySelectorAll('.btn-next').forEach(btn => {
    btn.addEventListener('click', () => {
      if (!validateStep(currentStep)) return;
      goToStep(Number(btn.dataset.next));
    });
  });

  document.querySelectorAll('.btn-back').forEach(btn => {
    btn.addEventListener('click', () => {
      goToStep(Number(btn.dataset.back));
    });
  });

  sidebarSteps.forEach(s => {
    s.addEventListener('click', () => {
      const n = Number(s.dataset.step);
      if (n <= maxStepReached) goToStep(n);
    });
  });
  document.getElementById('addHomeForm').addEventListener('submit', (e) => {
    for (let n = 1; n <= formSteps.length; n++) {
      const el = stepEl(n);
      const fields = el.querySelectorAll('input, select, textarea');
      for (const field of fields) {
        if (!field.checkValidity()) {
          e.preventDefault();
          goToStep(n);
          field.reportValidity();
          return;
        }
      }
    }
  });

  renderSidebar();

  function stepInput(id, step) {
    const input = document.getElementById(id);

    let value = parseInt(input.value || 0, 10);
    value += step;

    const min = input.min ? parseInt(input.min, 10) : -Infinity;
    const max = input.max ? parseInt(input.max, 10) : Infinity;

    value = Math.max(min, Math.min(max, value));

    input.value = value;
    input.dispatchEvent(new Event("input", { bubbles: true }));
}
</script>
<%- include('../partials/footer') %>
</body>


</html>