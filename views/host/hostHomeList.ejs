<%- include('../partials/header', { pageTitle: "Your Listings" }) %>
<link rel="stylesheet" href="/css/host/hostHomeList.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.2.0/remixicon.min.css">
</head>

<body class="host-listings-body">
<%- include('../partials/navbar') %>

<main class="host-listings-page">

  <section class="listings-hero">
    <div class="hero-overlay"></div>
    <div class="hero-gradient"></div>
    <div class="hero-content">
      <div class="hero-text">
        <p class="hero-mini">YOUR PORTFOLIO</p>
        <h1>
          Your listed
          <span>properties.</span>
        </h1>
        <p class="hero-description">
          Manage, edit, and track all the homes you've listed on Nestora.
          Every stay starts here.
        </p>
      </div>
    </div>
  </section>

  <section class="listings-section">
    <div class="listings-topbar">
      <p><%= totalHomes %> listing<%= totalHomes !== 1 ? 's' : '' %><% if (totalPages > 1) { %> — page <%= currentPage %> of <%= totalPages %><% } %></p>
      <a href="/host/addHome" class="topbar-add-btn">
        <i class="ri-add-line"></i>
        New listing
      </a>
    </div>
    <% if (registeredHomes.length === 0) { %>
      <div class="empty-state">
        <div class="empty-icon">
          <i class="ri-home-3-line"></i>
        </div>
        <h2>No listings yet</h2>
        <p>You haven't listed any homes. Add your first property to start hosting guests.</p>
        <a href="/host/addHome" class="empty-btn">
          List your first home
          <i class="ri-arrow-right-line"></i>
        </a>
      </div>
    <% } else { %>
      <div class="listings-grid">
        <% registeredHomes.forEach(home => { %>
          <div class="listing-card">
            <div class="listing-image">
              <img src="<%= home.photos[0] %>" alt="<%= home.houseName %>">
              <div class="listing-image-overlay">
                <a href="/host/editHome/<%= home._id %>?editing=true" class="overlay-btn">
                  <i class="ri-edit-line"></i>
                </a>
              </div>
              <span class="listing-badge">
                <i class="ri-checkbox-circle-fill"></i>
                Live
              </span>
            </div>
            <div class="listing-content">
              <div class="listing-top">
                <h3><%= home.houseName %></h3>
                <div class="listing-price">
                  ₹<%= home.price %>
                  <span>/ night</span>
                </div>
              </div>
              <p class="home-location">
                <% if (home.city && home.state) { %>
                  <%= home.city %>, <%= home.state %>
                <% } else { %>
                  <%= home.location %>
                <% } %>
              </p>

              <div class="listing-chips">
                <span class="chip">
                  <i class="ri-hotel-bed-line"></i>
                  <%= home.no_of_bedRooms %> bedroom<%= home.no_of_bedRooms > 1 ? 's' : '' %>
                </span>
                <span class="chip">
                  <i class="ri-group-line"></i>
                  <%= home.maxGuests %> guest<%= home.maxGuests > 1 ? 's' : '' %>
                </span>
              </div>
              <% if (home.description) { %>
                <p class="listing-desc"><%= home.description.length > 100 ? home.description.substring(0, 100) + '…' : home.description %></p>
              <% } %>
              <div class="listing-actions">
                  <div class="action-row">
                      <a href="/homeList/<%= home._id %>" class="action-btn secondary-btn">
                          <i class="ri-eye-line"></i>
                          View Listing
                      </a>
                      <a href="/host/analytics/<%= home._id %>" class="action-btn secondary-btn">
                          <i class="ri-line-chart-line"></i>
                          Analytics
                      </a>
                  </div>
                  <div class="action-row">
                      <a href="/host/manage/<%= home._id %>" class="action-btn secondary-btn">
                          <i class="ri-calendar-2-line"></i>
                          Manage
                      </a>
                      <!-- Future button -->
                      <!-- <div class="action-placeholder"></div> -->
                  </div>
                  <div class="action-row">
                      <a href="/host/editHome/<%= home._id %>?editing=true"
                        class="action-btn edit-btn">
                          <i class="ri-edit-line"></i>
                          Edit
                      </a>
                      <form action="/host/deleteHome/<%= home._id %>"
                            method="POST"
                            class="delete-form">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit"
                                  class="action-btn delete-btn"
                                  data-home-name="<%= home.houseName %>">
                              <i class="ri-delete-bin-line"></i>
                              Delete
                          </button>
                      </form>
                  </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <% if (totalPages > 1) { %>
        <nav class="pagination" aria-label="Listings pagination">
          <a
            href="/host/hostHomeList?page=<%= currentPage - 1 %>"
            class="page-btn page-nav <%= !hasPrevPage ? 'disabled' : '' %>"
            aria-disabled="<%= !hasPrevPage %>"
            <%= !hasPrevPage ? 'tabindex="-1"' : '' %>
          >
            <i class="ri-arrow-left-s-line"></i>
            Prev
          </a>
          <div class="page-numbers">
            <% for (let p = 1; p <= totalPages; p++) { %>
              <a
                href="/host/hostHomeList?page=<%= p %>"
                class="page-btn page-num <%= p === currentPage ? 'active' : '' %>"
                <%= p === currentPage ? 'aria-current="page"' : '' %>
              ><%= p %></a>
            <% } %>
          </div>
          <a
            href="/host/hostHomeList?page=<%= currentPage + 1 %>"
            class="page-btn page-nav <%= !hasNextPage ? 'disabled' : '' %>"
            aria-disabled="<%= !hasNextPage %>"
            <%= !hasNextPage ? 'tabindex="-1"' : '' %>
          >
            Next
            <i class="ri-arrow-right-s-line"></i>
          </a>
        </nav>
      <% } %>
    <% } %>
  </section>
  <div class="modal-overlay" id="deleteModalOverlay">
    <div class="modal-card">
      <div class="modal-icon">
        <i class="ri-delete-bin-6-line"></i>
      </div>
      <h3>Delete listing?</h3>
      <p>Are you sure you want to delete <strong id="deleteModalHomeName"></strong>? This cannot be undone.</p>
      <div class="modal-actions">
        <button type="button" class="modal-btn modal-cancel" id="deleteModalCancel">Cancel</button>
        <button type="button" class="modal-btn modal-confirm" id="deleteModalConfirm">
          <i class="ri-delete-bin-line"></i>
          Delete
        </button>
      </div>
    </div>
  </div>

  <div class="modal-overlay" id="notePickerOverlay">
    <div class="modal-card">
      <div class="modal-icon"><i class="ri-error-warning-line"></i></div>
      <h3>Active bookings on this listing</h3>
      <p id="notePickerMessage"></p>
      <div class="note-picker-field">
        <label for="notePickerReason">Reason to share with guest(s)</label>
        <select id="notePickerReason" class="note-picker-select">
          <option value="maintenance">Maintenance issue</option>
          <option value="double_booked">Scheduling conflict</option>
          <option value="unavailable">No longer available</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div class="note-picker-field" id="notePickerCustomWrap" style="display:none;">
        <label for="notePickerCustom">Custom note</label>
        <textarea id="notePickerCustom" class="note-picker-textarea" rows="3" maxlength="1000" placeholder="Explain why the booking is being cancelled..."></textarea>
      </div>
      <div class="modal-actions">
        <button type="button" class="modal-btn modal-cancel" id="notePickerCancel">Cancel</button>
        <button type="button" class="modal-btn modal-confirm" id="notePickerConfirm">
          <i class="ri-delete-bin-line"></i> Cancel bookings & delete
        </button>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
<script>
  const overlay      = document.getElementById('deleteModalOverlay');
  const nameEl        = document.getElementById('deleteModalHomeName');
  const cancelBtn     = document.getElementById('deleteModalCancel');
  const confirmBtn    = document.getElementById('deleteModalConfirm');
  let pendingForm      = null;

  document.querySelectorAll('.delete-form').forEach(form => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      pendingForm = form;
      nameEl.textContent = form.querySelector('.delete-btn').dataset.homeName;
      overlay.classList.add('open');
    });
  });

  function closeModal() {
    overlay.classList.remove('open');
    pendingForm = null;
  }

  cancelBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('open')) closeModal();
  });

  confirmBtn.addEventListener('click', async () => {
    if (!pendingForm) return;
    const form = pendingForm;
    closeModal();
    await attemptDelete(form);
  });

  // --- note-picker (409 flow) ---
  const noteOverlay     = document.getElementById('notePickerOverlay');
  const noteMessage     = document.getElementById('notePickerMessage');
  const noteReason      = document.getElementById('notePickerReason');
  const noteCustomWrap  = document.getElementById('notePickerCustomWrap');
  const noteCustom      = document.getElementById('notePickerCustom');
  const noteCancelBtn   = document.getElementById('notePickerCancel');
  const noteConfirmBtn  = document.getElementById('notePickerConfirm');
  let notePendingForm   = null;

  noteReason.addEventListener('change', () => {
    noteCustomWrap.style.display = noteReason.value === 'other' ? 'block' : 'none';
  });

  function openNotePicker(form, message) {
    notePendingForm = form;
    noteMessage.textContent = message || 'This listing has upcoming bookings. Choose a reason to notify guests before deleting.';
    noteReason.value = 'maintenance';
    noteCustomWrap.style.display = 'none';
    noteCustom.value = '';
    noteOverlay.classList.add('open');
  }

  function closeNotePicker() {
    noteOverlay.classList.remove('open');
    notePendingForm = null;
  }

  noteCancelBtn.addEventListener('click', closeNotePicker);
  noteOverlay.addEventListener('click', (e) => { if (e.target === noteOverlay) closeNotePicker(); });

  noteConfirmBtn.addEventListener('click', async () => {
    if (!notePendingForm) return;
    const form = notePendingForm;
    const extra = {
      confirmCancel: 'true',
      noteType: noteReason.value === 'other' ? 'custom' : 'predefined',
      predefinedReason: noteReason.value,
      customNote: noteCustom.value
    };
    closeNotePicker();
    await attemptDelete(form, extra);
  });

  async function attemptDelete(form, extraFields = null) {
  const formData = new FormData(form);
  if (extraFields) {
    Object.entries(extraFields).forEach(([k, v]) => formData.set(k, v));
  }
  const params = new URLSearchParams();
  for (const [key, value] of formData.entries()) {
    params.append(key, value);
  }
  try {
    const res = await fetch(form.action, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: params
    });
    if (res.status === 409) {
      const data = await res.json();
      openNotePicker(form, data.message);
      return;
    }
    window.location.href = res.url || '/host/hostHomeList';
  } catch (err) {
    alert('Something went wrong deleting this listing. Please try again.');
  }
}
</script>
</body>
</html>

