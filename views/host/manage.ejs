<%- include('../partials/header', { pageTitle: "Manage Dates" }) %>
<link rel="stylesheet" href="/css/host/manage.css">
<link rel="stylesheet" href="/css/host/hostHomeList.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.2.0/remixicon.min.css">
</head>
<body class="manage-dates-body">
<%- include('../partials/navbar') %>

<main class="manage-dates-page">
  <a href="/host/dashboard" class="btn-ghost">
    <i class="ri-arrow-left-line"></i>
    Back to Dashboard
  </a>

  <div class="manage-header">
    <h1><%= home.houseName %></h1>
    <p>Manage availability & blocked dates</p>
  </div>

  <div class="panels-row">
    <section class="panel">
      <h2>Block Dates</h2>
      <form action="/host/block-dates" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="homeId" value="<%= home._id %>">
        <div class="field-grid" style="grid-template-columns: 1fr; gap: 14px;">
          <div class="field-group">
            <label>From</label>
            <input type="date" name="from" required>
          </div>
          <div class="field-group">
            <label>To</label>
            <input type="date" name="to" required>
          </div>
          <div class="field-group">
            <label>Reason (optional)</label>
            <input type="text" name="reason" placeholder="e.g. Personal use">
          </div>
          <button type="submit" class="btnn btn-primary">Block</button>
        </div>
      </form>
    </section>

    <section class="panel">
      <h2>Blocked Periods</h2>
      <div style="flex: 1;">
        <% if (home.blockedDates && home.blockedDates.length > 0) { %>
          <div style="margin-top:16px;">
            <% home.blockedDates.forEach(b => { %>
              <div class="list-row list-row--danger">
                <div>
                  <p class="list-row-title"><%= new Date(b.from).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %> → <%= new Date(b.to).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %></p>
                  <% if(b.reason) { %><p class="list-row-sub"><%= b.reason %></p><% } %>
                </div>
                <form action="/host/unblock-dates/<%= home._id %>/<%= b._id %>" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btnn btn-danger-soft">Unblock</button>
                </form>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="empty-text">No dates blocked yet.</p>
        <% } %>
      </div>
      <div class="panel-tip">
        <i class="ri-lightbulb-line"></i>
        <p>Blocking dates stops guests from booking your home during that period — handy for personal stays, maintenance, or bookings made off-platform. Blocked ranges never overlap with anything already booked and paid for.</p>
      </div>
    </section>
  </div>

  <section class="panel">
    <h2>Seasonal Pricing</h2>
    <p class="panel-sub">Base price: $<%= home.price %>/night. Add a date range to override it for peak periods.</p>
    <form action="/host/add-pricing" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="homeId" value="<%= home._id %>">
      <div class="field-grid field-grid--pricing">
        <div class="field-group">
          <label>From</label>
          <input type="date" name="from" required>
        </div>
        <div class="field-group">
          <label>To</label>
          <input type="date" name="to" required>
        </div>
        <div class="field-group">
          <label>Price/night ($)</label>
          <div class="number-input-wrap">
            <input type="number" id="seasonalPrice" name="price" min="1" required>
            <div class="spin-btns">
              <button type="button" class="spin-btn spin-up" onclick="stepInput('seasonalPrice', 1)"></button>
              <button type="button" class="spin-btn spin-down" onclick="stepInput('seasonalPrice', -1)"></button>
            </div>
          </div>
        </div>
        <div class="field-group">
          <label>Label (optional)</label>
          <input type="text" name="label" placeholder="e.g. Diwali week">
        </div>
        <button type="submit" class="btnn btn-primary">Add rule</button>
      </div>
    </form>

    <% if (home.seasonalPricing && home.seasonalPricing.length > 0) { %>
      <div style="margin-top:16px;">
        <% home.seasonalPricing.forEach(rule => { %>
          <div class="list-row">
            <div>
              <p class="list-row-title">
                <%= new Date(rule.from).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %> → <%= new Date(rule.to).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
                — $<%= rule.price %>/night
              </p>
              <% if (rule.label) { %><p class="list-row-sub"><%= rule.label %></p><% } %>
            </div>
            <form action="/host/remove-pricing/<%= home._id %>/<%= rule._id %>" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btnn btn-danger-soft">Remove</button>
            </form>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <section class="panel">
    <h2>Calendar Sync</h2>
    <p class="panel-sub">Export this home's bookings to other platforms, or import their calendars so double-bookings are blocked automatically.</p>

    <div style="margin-bottom:20px;">
      <div class="field-group">
        <label>Your export link (paste into Airbnb/Google Calendar as an iCal URL)</label>
        <input type="text" readonly value="<%= process.env.APP_URL %>/host/calendar/<%= home._id %>/<%= home.icalExportToken %>.ics">
      </div>
    </div>

    <form action="/host/add-calendar" method="POST" style="margin-bottom:16px;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="homeId" value="<%= home._id %>">
      <div class="field-grid field-grid--calendar">
        <div class="field-group">
          <label>Calendar name</label>
          <input type="text" name="name" placeholder="e.g. Airbnb">
        </div>
        <div class="field-group">
          <label>iCal URL to import</label>
          <input type="url" name="url" required placeholder="https://www.airbnb.com/calendar/ical/...">
        </div>
        <button type="submit" class="btnn btn-primary">Add</button>
      </div>
    </form>

    <% if (home.externalCalendars && home.externalCalendars.length > 0) { %>
      <% home.externalCalendars.forEach(cal => { %>
        <div class="list-row">
          <div>
            <p class="list-row-title"><%= cal.name || 'Untitled calendar' %></p>
            <p class="list-row-meta"><%= cal.url %></p>
            <p class="list-row-sub">
              <%= cal.lastSyncedAt ? 'Last synced ' + new Date(cal.lastSyncedAt).toLocaleString('en-IN') : 'Never synced' %>
            </p>
          </div>
          <form action="/host/remove-calendar/<%= home._id %>/<%= cal._id %>" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btnn btn-danger-soft">Remove</button>
          </form>
        </div>
      <% }) %>
      <form action="/host/sync-calendars/<%= home._id %>" method="POST" style="margin-top:8px;">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="btnn btn-neutral">
          <i class="ri-refresh-line"></i> Sync now
        </button>
      </form>
    <% } %>
  </section>

  <div class="panels-row">
    <section class="panel">
      <h2>Guest Bookings</h2>
      <% if (!bookings || bookings.length === 0) { %>
        <p class="empty-text">No bookings for this property yet.</p>
      <% } else { %>
        <% bookings.forEach(b => { %>
          <div class="list-row" data-booking-id="<%= b._id %>">
            <div>
              <p class="list-row-title"><%= b.guest.fname %> <%= b.guest.lname %></p>
              <p class="list-row-sub"><%= b.guest.email %><% if (b.guest.phone) { %> · <%= b.guest.phone %><% } %></p>
              <p class="list-row-sub">
                Booking #<%= b.bookingId || b._id %>
              </p>
              <p class="list-row-sub">
                <%= new Date(b.checkIn).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %> →
                <%= new Date(b.checkOut).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
                · <%= b.nights %> night<%= b.nights > 1 ? 's' : '' %>
                · ₹<%= b.totalPrice %> · payment: <%= b.paymentStatus %>
              </p>
              <% if (b.status === 'cancelled') { %>
                <p class="list-row-sub">
                  Cancelled by <%= b.cancelledBy || 'system' %>
                  <% if (b.refundAmount > 0) { %> · ₹<%= b.refundAmount %> refunded (<%= b.refundStatus %>)<% } %>
                  <% if (b.hostCancelNote) { %> · note: "<%= b.hostCancelNote %>"<% } %>
                </p>
              <% } %>
            </div>
            <div style="display:flex; flex-direction:column; align-items:flex-end; gap:6px;">
              <span class="badge badge-<%= b.status %>"><%= b.status %></span>
              <% if (b.status === 'upcoming') { %>
                <button type="button" class="host-cancel-btn" data-cancel-url="/host/bookings/<%= b._id %>/cancel">
                  Cancel booking
                </button>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } %>
    </section>

    <section class="panel">
      <h2>Guest Reviews</h2>
      <p class="panel-sub">
        <%= home.avgRating || 0 %>★ average · <%= home.reviewCount || 0 %> review<%= home.reviewCount !== 1 ? 's' : '' %>
      </p>

      <% if (!reviews || reviews.length === 0) { %>
        <p class="empty-text">No reviews yet for this property.</p>
      <% } else { %>
        <% reviews.forEach(r => { %>
          <div class="review-row">
            <div class="review-top">
              <img src="<%= r.guest.profileImage %>" class="review-avatar">
              <div>
                <p class="review-name"><%= r.guest.fname %> <%= r.guest.lname %></p>
                <p class="review-date"><%= new Date(r.createdAt).toLocaleDateString('en-IN',{month:'short',year:'numeric'}) %></p>
              </div>
              <div class="review-stars">
                <% for(let i=1;i<=5;i++) { %>
                  <i class="ri-star-<%= i <= r.rating ? 'fill' : 'line' %> <%= i <= r.rating ? 'star-filled' : 'star-empty' %>"></i>
                <% } %>
              </div>
            </div>
            <p class="review-comment"><%= r.comment %></p>
          </div>
        <% }) %>
      <% } %>
    </section>
  </div>
  <div class="modal-overlay" id="notePickerOverlay">
    <div class="modal-card">
      <div class="modal-icon"><i class="ri-error-warning-line"></i></div>
      <h3>Cancel this booking?</h3>
      <p id="notePickerMessage">This will cancel the booking, refund the guest, and send them your note.</p>
      <div class="note-picker-field">
        <label for="notePickerReason">Reason to share with guest</label>
        <select id="notePickerReason" class="note-picker-select">
          <option value="maintenance">Maintenance issue</option>
          <option value="double_booked">Scheduling conflict</option>
          <option value="unavailable">No longer available</option>
          <option value="other">Other</option>
        </select>
      </div>
      <div class="note-picker-field" id="notePickerCustomWrap" style="display:none;">
        <label for="notePickerCustom">Custom note</label>
        <textarea id="notePickerCustom" class="note-picker-textarea" rows="3" maxlength="1000" placeholder="Explain why the booking is being cancelled..."></textarea>
      </div>
      <div class="modal-actions">
        <button type="button" class="modal-btn modal-cancel" id="notePickerCancel">Cancel</button>
        <button type="button" class="modal-btn modal-confirm" id="notePickerConfirm">
          <i class="ri-delete-bin-line"></i> Cancel booking
        </button>
      </div>
    </div>
  </div>
</main>
<%- include('../partials/footer') %>
<script>
  const noteOverlay    = document.getElementById('notePickerOverlay');
  const noteMessage    = document.getElementById('notePickerMessage');
  const noteReason     = document.getElementById('notePickerReason');
  const noteCustomWrap = document.getElementById('notePickerCustomWrap');
  const noteCustom     = document.getElementById('notePickerCustom');
  const noteCancelBtn  = document.getElementById('notePickerCancel');
  const noteConfirmBtn = document.getElementById('notePickerConfirm');
  let pendingCancelUrl = null;

  noteReason.addEventListener('change', () => {
    noteCustomWrap.style.display = noteReason.value === 'other' ? 'block' : 'none';
  });

  document.querySelectorAll('.host-cancel-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      pendingCancelUrl = btn.dataset.cancelUrl;
      noteReason.value = 'maintenance';
      noteCustomWrap.style.display = 'none';
      noteCustom.value = '';
      noteOverlay.classList.add('open');
    });
  });

  function closeNotePicker() {
    noteOverlay.classList.remove('open');
    pendingCancelUrl = null;
  }

  noteCancelBtn.addEventListener('click', closeNotePicker);
  noteOverlay.addEventListener('click', (e) => { if (e.target === noteOverlay) closeNotePicker(); });

  noteConfirmBtn.addEventListener('click', async () => {
    if (!pendingCancelUrl) return;
    const formData = new FormData();
    formData.set('_csrf', '<%= csrfToken %>');
    formData.set('noteType', noteReason.value === 'other' ? 'custom' : 'predefined');
    formData.set('predefinedReason', noteReason.value);
    formData.set('customNote', noteCustom.value);
    formData.set('returnTo', window.location.pathname);

    const params = new URLSearchParams();
    for (const [key, value] of formData.entries()) {
      params.append(key, value);
    }

    const url = pendingCancelUrl;
    closeNotePicker();
    try {
      const res = await fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params
      });
      window.location.href = res.url || window.location.pathname;
    } catch (err) {
      alert('Something went wrong cancelling this booking. Please try again.');
    }
  });
  function stepInput(id, step) {
    const input = document.getElementById(id);
    let value = parseInt(input.value || 0, 10);
    value += step* 100;;
    const min = input.min ? parseInt(input.min, 10) : -Infinity;
    const max = input.max ? parseInt(input.max, 10) : Infinity;
    value = Math.max(min, Math.min(max, value));
    input.value = value;
    input.dispatchEvent(new Event("input", { bubbles: true }));
  }
</script>
</body>
</html>