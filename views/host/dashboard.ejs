<%- include('../partials/header', { pageTitle: "Host Dashboard" }) %>
<link rel="stylesheet" href="/css/host/dashboard.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.2.0/remixicon.min.css">
</head>

<body class="dashboard-body">
<%- include('../partials/navbar') %>

<main class="dashboard-page">

  <div class="dashboard-header">
    <p class="dashboard-eyebrow">Host Dashboard</p>
    <h1>Welcome back, <%= user.fname %></h1>
    <p>Here's how your properties are performing.</p>
  </div>

  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-top">
        <div>
          <p class="stat-label">Total Revenue</p>
          <p class="stat-value stat-value--revenue">₹<%= stats.totalRevenue.toLocaleString('en-IN') %></p>
        </div>
        <div class="stat-icon-box stat-icon-box--good">
          <i class="ri-money-rupee-circle-line"></i>
        </div>
      </div>
      <p class="stat-note">From all paid bookings</p>
    </div>

    <div class="stat-card">
      <div class="stat-top">
        <div>
          <p class="stat-label">Total Bookings</p>
          <p class="stat-value"><%= stats.totalBookings %></p>
        </div>
        <div class="stat-icon-box stat-icon-box--indigo">
          <i class="ri-calendar-check-line"></i>
        </div>
      </div>
      <p class="stat-note">
        <span class="stat-note-highlight"><%= stats.upcomingBookings %> upcoming</span>
        · <%= stats.completedBookings %> completed
      </p>
    </div>

    <div class="stat-card">
      <div class="stat-top">
        <div>
          <p class="stat-label">Avg Rating</p>
          <p class="stat-value">
            <%= stats.avgRating || '—' %>
            <% if (stats.avgRating) { %><span class="stat-rating-star">★</span><% } %>
          </p>
        </div>
        <div class="stat-icon-box stat-icon-box--gold">
          <i class="ri-star-line"></i>
        </div>
      </div>
      <p class="stat-note"><%= stats.totalReviews %> review<%= stats.totalReviews !== 1 ? 's' : '' %> across all listings</p>
    </div>

  </div>

  <div class="dashboard-grid">
    <div class="main-stack">
      <div class="panel">
        <h2>Bookings — Last 6 Months</h2>
        <% if (monthlyData.length === 0) { %>
          <p class="chart-empty">No booking data yet.</p>
        <% } else { %>
          <% const maxBookings = Math.max(...monthlyData.map(m => m.bookings)); %>
          <% monthlyData.forEach(m => { %>
            <% const barWidth = maxBookings > 0 ? Math.round((m.bookings/maxBookings)*100) : 0; %>
            <div class="chart-row">
              <div class="chart-row-header">
                <span><%= m.label %></span>
                <span><%= m.bookings %> booking<%= m.bookings !== 1 ? 's' : '' %> · ₹<%= m.revenue.toLocaleString('en-IN') %></span>
              </div>
              <div class="chart-bar-track">
                <div class="chart-bar-fill" data-width="<%= barWidth %>"></div>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

      <div class="panel">
        <h2>Upcoming Check-ins</h2>
        <% if (upcomingCheckins.length === 0) { %>
          <p class="empty-text">No upcoming check-ins.</p>
        <% } else { %>
          <% upcomingCheckins.forEach(b => { %>
            <div class="checkin-row">
              <img src="<%= b.guest.profileImage %>" class="checkin-avatar">
              <div class="checkin-info">
                <p class="checkin-guest"><%= b.guest.fname %> <%= b.guest.lname %></p>
                <p class="checkin-meta">
                  <%= b.home.houseName %> ·
                  <%= new Date(b.checkIn).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %>
                </p>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>

    </div>

    <div class="side-stack">
      <div class="panel">
        <h2>Most Booked Listing</h2>
        <% if (!mostBooked) { %>
          <p class="empty-text">No bookings yet.</p>
        <% } else { %>
          <div class="most-booked-row">
            <img src="<%= mostBooked.home.photos[0] %>" class="most-booked-thumb">
            <div>
              <p class="most-booked-name"><%= mostBooked.home.houseName %></p>
              <p class="most-booked-meta"><%= mostBooked.count %> bookings · ₹<%= mostBooked.revenue.toLocaleString('en-IN') %> earned</p>
            </div>
          </div>
        <% } %>
      </div>

      <div class="panel">
        <h2>Your Listings (<%= homes.length %>)</h2>
        <% homes.forEach(h => { %>
          <div class="mini-listing-row">
            <div class="mini-listing-info">
              <img src="<%= h.photos[0] %>" class="mini-listing-thumb">
              <div>
                <p class="mini-listing-name"><%= h.houseName %></p>
                <p class="mini-listing-price">₹<%= h.price %>/night</p>
              </div>
            </div>
            <a href="/host/manage-dates/<%= h._id %>" class="manage-link">Manage →</a>
          </div>
        <% }) %>
      </div>

    </div>
  </div>

  <div class="panel">
    <div class="panel-header-row">
      <h2>Recent Bookings</h2>
      <a href="/host/hostHomeList" class="view-all-link">View all listings →</a>
    </div>
    <% if (recentBookings.length === 0) { %>
      <p class="empty-text">No bookings yet.</p>
    <% } else { %>
      <% recentBookings.forEach(b => { %>
        <div class="booking-row" data-booking-id="<%= b._id %>">
          <div class="booking-guest">
            <img src="<%= b.guest.profileImage %>" class="booking-avatar">
            <div>
              <p class="booking-guest-name"><%= b.guest.fname %> <%= b.guest.lname %></p>
              <p class="booking-guest-meta">
                <%= b.home.houseName %> ·
                <%= new Date(b.checkIn).toLocaleDateString('en-IN',{day:'numeric',month:'short'}) %> →
                <%= new Date(b.checkOut).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
              </p>
            </div>
          </div>
          <div class="booking-amount-col">
            <p class="booking-amount">₹<%= b.totalPrice.toLocaleString('en-IN') %></p>
            <span class="badge badge-<%= b.status %>"><%= b.status %></span>
            <% if (b.status === 'upcoming') { %>
              <button type="button" class="host-cancel-btn" data-cancel-url="/host/bookings/<%= b._id %>/cancel">
                Cancel booking
              </button>
            <% } %>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>

  <div class="export-row">
    <form method="GET" action="/host/payouts/export" style="display:flex;align-items:center;gap:8px;">
      <select name="year" class="export-select">
        <option value="">All time</option>
        <% const thisYear = new Date().getFullYear(); %>
        <% for (let y = thisYear; y >= thisYear - 3; y--) { %>
          <option value="<%= y %>"><%= y %></option>
        <% } %>
      </select>
      <button type="submit" name="format" value="csv" class="btnn btn-neutral">
        <i class="ri-file-text-line"></i> CSV
      </button>
      <button type="submit" name="format" value="pdf" class="btnn btn-primary">
        <i class="ri-file-pdf-2-line"></i> PDF
      </button>
    </form>
  </div>

  <div class="panel">
    <h2>Payouts</h2>
    <div class="payouts-summary-grid">
      <div class="payout-summary-card payout-summary-card--pending">
        <p class="payout-summary-label">Pending payout</p>
        <p class="payout-summary-value">₹<%= payoutSummary.pendingAmount.toLocaleString('en-IN') %></p>
        <p class="payout-summary-meta">
          <%= payoutSummary.pendingCount %> booking<%= payoutSummary.pendingCount !== 1 ? 's' : '' %>
          <% if (payoutSummary.nextDue) { %> · next due <%= new Date(payoutSummary.nextDue).toLocaleDateString('en-IN') %><% } %>
        </p>
      </div>
      <div class="payout-summary-card payout-summary-card--paid">
        <p class="payout-summary-label">Paid out so far</p>
        <p class="payout-summary-value">₹<%= payoutSummary.paidAmount.toLocaleString('en-IN') %></p>
      </div>
      <div class="payout-summary-card payout-summary-card--info">
        <p class="payout-summary-label">How it works</p>
        <p class="payout-summary-info-text">You're paid within 3 days of a guest booking, with the platform commission already deducted from the total.</p>
      </div>
    </div>

    <h3 class="payout-details-heading">Payout details</h3>
    <% const pd = user.payoutDetails || {}; %>
    <% if (!pd.method) { %>
      <p class="payout-warning">You haven't added payout details yet — add them below so we know where to send your earnings.</p>
    <% } %>
    <form method="POST" action="/host/payout-details" id="payoutForm" class="payout-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="method-toggle">
        <label class="method-option">
          <input type="radio" name="method" value="upi" id="method-upi" <%= pd.method === 'upi' || !pd.method ? 'checked' : '' %>>
          UPI
        </label>
        <label class="method-option">
          <input type="radio" name="method" value="bank" id="method-bank" <%= pd.method === 'bank' ? 'checked' : '' %>>
          Bank transfer
        </label>
      </div>

      <div id="upiFields" class="payout-field-group">
        <label>UPI ID</label>
        <input type="text" name="upiId" value="<%= pd.upiId || '' %>" placeholder="yourname@upi">
      </div>

      <div id="bankFields">
        <div class="payout-field-group">
          <label>Account holder name</label>
          <input type="text" name="accountHolderName" value="<%= pd.accountHolderName || '' %>">
        </div>
        <div class="payout-field-group">
          <label>Account number</label>
          <input type="text" name="accountNumber" value="<%= pd.accountNumber || '' %>">
        </div>
        <div class="payout-field-group">
          <label>IFSC</label>
          <input type="text" name="ifsc" value="<%= pd.ifsc || '' %>" class="ifsc-input">
        </div>
      </div>
      <button type="submit" class="btnn btn-primary">Save payout details</button>
    </form>
  </div>

</main>
<%- include('../partials/footer') %>
<script>
  document.querySelectorAll('[data-width]').forEach(el => {
    el.style.width = el.dataset.width + '%';
  });

  (function () {
    const upiRadio   = document.getElementById('method-upi');
    const bankRadio  = document.getElementById('method-bank');
    const upiFields  = document.getElementById('upiFields');
    const bankFields = document.getElementById('bankFields');
    const toggle = () => {
      const isUpi = upiRadio.checked;
      upiFields.style.display  = isUpi ? 'block' : 'none';
      bankFields.style.display = isUpi ? 'none'  : 'block';
    };
    upiRadio.addEventListener('change', toggle);
    bankRadio.addEventListener('change', toggle);
    toggle();
  })();
  const noteOverlay    = document.getElementById('notePickerOverlay');
  const noteMessage    = document.getElementById('notePickerMessage');
  const noteReason     = document.getElementById('notePickerReason');
  const noteCustomWrap = document.getElementById('notePickerCustomWrap');
  const noteCustom     = document.getElementById('notePickerCustom');
  const noteCancelBtn  = document.getElementById('notePickerCancel');
  const noteConfirmBtn = document.getElementById('notePickerConfirm');
  let pendingCancelUrl = null;

  noteReason.addEventListener('change', () => {
    noteCustomWrap.style.display = noteReason.value === 'other' ? 'block' : 'none';
  });

  document.querySelectorAll('.host-cancel-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      pendingCancelUrl = btn.dataset.cancelUrl;
      noteMessage.textContent = 'This will cancel the booking, refund the guest, and send them your note.';
      noteReason.value = 'maintenance';
      noteCustomWrap.style.display = 'none';
      noteCustom.value = '';
      noteOverlay.classList.add('open');
    });
  });

  function closeNotePicker() {
    noteOverlay.classList.remove('open');
    pendingCancelUrl = null;
  }

  noteCancelBtn.addEventListener('click', closeNotePicker);
  noteOverlay.addEventListener('click', (e) => { if (e.target === noteOverlay) closeNotePicker(); });

  noteConfirmBtn.addEventListener('click', async () => {
  if (!pendingCancelUrl) return;
  const formData = new FormData();
  formData.set('_csrf', '<%= csrfToken %>');
  formData.set('noteType', noteReason.value === 'other' ? 'custom' : 'predefined');
  formData.set('predefinedReason', noteReason.value);
  formData.set('customNote', noteCustom.value);
  const url = pendingCancelUrl;
  closeNotePicker();
  try {
    const res = await fetch(url, { method: 'POST', body: formData });
    window.location.href = res.url || '/host/dashboard';
  } catch (err) {
    alert('Something went wrong cancelling this booking. Please try again.');
  }
});
</script>
</body>
</html>