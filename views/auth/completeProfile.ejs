<%- include('../partials/header') %>
<link rel="stylesheet" href="/css/auth/signup.css">
</head>
<body class="signup-body">
  <section class="signup-section">
    <div class="signup-wrapper">
      <div class="signup-content">
        <p class="small-tag">One Last Step</p>
        <h1>Almost <span>there.</span></h1>
        <p class="signup-text">
          Just a few more details to complete your profile.
        </p>
      </div>
      <div class="form-box">
        <% if (typeof errors !== "undefined" && errors.length > 0) { %>
          <div class="error-alert">
            <ul>
              <% errors.forEach(function(e) { %>
                <li><%= e %></li>
              <% }) %>
            </ul>
          </div>
        <% } %>
        <form action="/complete-profile" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="input-row">
            <div class="input-group">
              <label for="fname">First name</label>
              <input type="text" id="fname" value="<%= user.fname %>" readonly disabled>
            </div>
            <div class="input-group">
              <label for="mname">Middle name <span>(optional)</span></label>
              <input
                type="text"
                id="mname"
                name="mname"
                placeholder="Optional"
                value="<%= typeof oldInput !== 'undefined' && oldInput.mname ? oldInput.mname : (user.mname || '') %>"
              >
            </div>
          </div>
          <div class="input-group">
            <label for="lname">Last name</label>
            <input type="text" id="lname" value="<%= user.lname %>" readonly disabled>
          </div>
          <div class="input-group">
            <label for="email">Email</label>
            <input type="email" id="email" value="<%= user.email %>" readonly disabled>
          </div>

          <div class="input-row">
            <div class="input-group">
              <label for="password">Set a password <span>(optional)</span></label>
              <div class="password-field">
                <input type="password" id="password" name="password" placeholder="Create password">
                <button type="button" class="pw-toggle" aria-label="Show password">
                  <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                  </svg>
                  <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                    <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a18.5 18.5 0 0 1 5.06-5.94M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                    <line x1="1" y1="1" x2="23" y2="23"/>
                  </svg>
                </button>
              </div>
            </div>
            <div class="input-group">
              <label for="Cpassword">Confirm <span>(optional)</span></label>
              <div class="password-field">
                <input type="password" id="Cpassword" name="Cpassword" placeholder="Repeat password">
                <button type="button" class="pw-toggle" aria-label="Show password">
                  <svg class="icon-eye" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                  </svg>
                  <svg class="icon-eye-off" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none;">
                    <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a18.5 18.5 0 0 1 5.06-5.94M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/>
                    <line x1="1" y1="1" x2="23" y2="23"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
          <p class="signup-text" style="margin-top:-0.5rem;font-size:0.85rem;">
            Setting a password lets you log in with your email too, not just Google.
          </p>

          <div class="input-group">
            <label>Are you joining as a:</label>
            <div class="role-choice">
              <label class="role-card">
                <input type="radio" name="role" value="guest" required <%= (typeof oldInput !== 'undefined' && oldInput.role === 'guest') ? 'checked' : '' %>>
                <span class="role-card-body">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                  Guest
                </span>
              </label>
              <label class="role-card">
                <input type="radio" name="role" value="host" <%= (typeof oldInput !== 'undefined' && oldInput.role === 'host') ? 'checked' : '' %>>
                <span class="role-card-body">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/></svg>
                  Host
                </span>
              </label>
            </div>
          </div>
          <div class="input-row">
            <div class="input-group">
              <label for="phone">Phone <span>(optional)</span></label>
              <input type="text" id="phone" name="phone" placeholder="+91 98765 43210" value="<%= typeof oldInput !== 'undefined' && oldInput.phone ? oldInput.phone : '' %>">
            </div>
            <div class="input-group">
              <label for="location">City <span>(optional)</span></label>
              <input type="text" id="location" name="location" placeholder="Kolkata" value="<%= typeof oldInput !== 'undefined' && oldInput.location ? oldInput.location : '' %>">
            </div>
          </div>
          <div class="input-group">
            <label for="country">Country <span>(optional)</span></label>
            <input type="text" id="country" name="country" placeholder="India" value="<%= typeof oldInput !== 'undefined' && oldInput.country ? oldInput.country : '' %>">
          </div>
          <div class="input-group">
            <label for="photo">Profile image <span>(optional)</span></label>
            <input type="file" id="photo" name="photo" accept="image/png,image/jpg,image/jpeg">
          </div>
          <div class="input-group">
            <label for="bio">Bio <span>(optional)</span></label>
            <textarea id="bio" name="bio" rows="4" placeholder="Tell us about yourself..."><%= typeof oldInput !== 'undefined' && oldInput.bio ? oldInput.bio : '' %></textarea>
          </div>
          <button type="submit" class="btn-signup">Complete Profile</button>
        </form>
      </div>
    </div>
  </section>
<script src="/js/passwordToggle.js"></script>
</body>
</html>