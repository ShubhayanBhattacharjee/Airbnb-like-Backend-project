<%- include("partials/header", { pageTitle: "Contact" }) %>
<link rel="stylesheet" href="/css/general/contact.css">
</head>
<body class="contact-body">
<%- include('partials/navbar') %>

<section class="contact-hero">
    <div class="contact-container">
        <div class="contact-content">
            <p class="small-tag">
                WE’D LOVE TO HEAR FROM YOU
            </p>
            <h1>
                Let’s stay
                <span>connected.</span>
            </h1>
            <p class="contact-text">
                Have a question, a suggestion, or simply want to say hello?
                We’re here to help and always happy to connect with you.
            </p>
            <div class="contact-features">
                <div class="feature-item">
                    <div class="feature-icon">✉</div>
                    <div>
                        <h4>Email us</h4>
                        <p>hello@roovia.com</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">☏</div>
                    <div>
                        <h4>Call directly</h4>
                        <p>+91 98765 43210</p>
                    </div>
                </div>
                <div class="feature-item">
                    <div class="feature-icon">⌂</div>
                    <div>
                        <h4>Visit us</h4>
                        <p>Kolkata, West Bengal</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="support-section" id="support">
    <div class="support-grid">
        <div class="support-info">
            <div class="status-strip">
                <span class="pulse-dot-good"></span>
                Support team online
            </div>
            <h2>Need help with something?</h2>
            <p>
                Booking trouble, a payment that didn’t go through, or a listing
                that looks off — tell us what’s wrong and our team will pick it
                up personally. No bots, no runaround.
            </p>
            <div class="support-stats">
                <div class="support-stat">
                    <div class="support-stat-num">&lt; 24h</div>
                    <div class="support-stat-label">Avg. response time</div>
                </div>
                <div class="support-stat">
                    <div class="support-stat-num">7 / 7</div>
                    <div class="support-stat-label">Days a week</div>
                </div>
                <div class="support-stat">
                    <div class="support-stat-num">2</div>
                    <div class="support-stat-label">Languages (EN / HI)</div>
                </div>
                <div class="support-stat">
                    <div class="support-stat-num">100%</div>
                    <div class="support-stat-label">Human replies</div>
                </div>
            </div>
        </div>

        <div class="support-form-panel">
            <h3>Report an issue</h3>
            <p class="form-sub">Fill in the details below and we’ll get back to you shortly.</p>
            <% if (typeof success !== 'undefined' && success) { %>
                <div class="form-banner form-banner-success">
                    Your request has been received. Our support team will get back to you within 24 hours.
                </div>
            <% } %>
            <% if (typeof error !== 'undefined' && error) { %>
                <div class="form-banner form-banner-error"><%= error %></div>
            <% } %>
            <form action="/contact/support" method="POST" id="supportForm">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="form-row">
                    <div class="form-group">
                        <label for="name">Full name</label>
                        <input type="text" id="name" name="name" placeholder="Your name" value="<%= (typeof user !== 'undefined' && user) ? (user.fname ? user.fname + ' ' + (user.lname || '') : user.name || '') : '' %>" required>
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" id="email" name="email" placeholder="you@example.com" value="<%= (typeof user !== 'undefined' && user) ? user.email : '' %>" required>
                    </div>
                </div>
                <% if (typeof user !== 'undefined' && user && user.role === 'host') { %>
                <div class="form-row">
                    <div class="form-group">
                        <label for="property_id">Property</label>
                        <% if (myProperties && myProperties.length > 0) { %>
                            <select id="property_id" name="property_id" required>
                                <option value="" disabled selected>Select a property</option>
                                <% myProperties.forEach(home => { %>
                                    <option value="<%= home._id %>"><%= home.houseName %> — <%= home.city %>, <%= home.state %></option>
                                <% }) %>
                            </select>
                        <% } else { %>
                            <select id="property_id" name="property_id" disabled required>
                                <option value="" selected>No booked property found</option>
                            </select>
                        <% } %>
                    </div>
                    <div class="form-group">
                        <label for="issue_type">Issue type</label>
                        <select id="issue_type" name="issue_type" required <%= (!myProperties || myProperties.length === 0) ? 'disabled' : '' %>>
                            <option value="" disabled selected>Select an issue</option>
                            <option value="listing">Property listing</option>
                            <option value="payment">Payout / commission</option>
                            <option value="account">Account access</option>
                            <option value="other">Something else</option>
                        </select>
                    </div>
                </div>
                <% if (!myProperties || myProperties.length === 0) { %>
                    <div class="form-banner form-banner-error">
                        You can only raise a ticket for a property that has at least one booking made against it. You don't have any yet.
                    </div>
                <% } %>
                <% } else { %>
                <div class="form-row">
                    <div class="form-group">
                        <label for="booking_id">Booking</label>
                        <% if (myBookings && myBookings.length > 0) { %>
                            <select id="booking_id" name="booking_id" required>
                                <option value="" disabled selected>Select a booking</option>
                                <% myBookings.forEach(booking => { %>
                                    <option value="<%= booking._id %>">
                                        <%= booking.bookingId %> — <%= booking.home ? booking.home.houseName : 'Home removed' %>
                                        (<%= new Date(booking.checkIn).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %> - <%= new Date(booking.checkOut).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>)
                                    </option>
                                <% }) %>
                            </select>
                        <% } else { %>
                            <select id="booking_id" name="booking_id" disabled required>
                                <option value="" selected>No bookings found</option>
                            </select>
                        <% } %>
                    </div>
                    <div class="form-group">
                        <label for="issue_type">Issue type</label>
                        <select id="issue_type" name="issue_type" required <%= (!myBookings || myBookings.length === 0) ? 'disabled' : '' %>>
                            <option value="" disabled selected>Select an issue</option>
                            <option value="booking">Booking issue</option>
                            <option value="payment">Payment / refund</option>
                            <option value="account">Account access</option>
                            <option value="other">Something else</option>
                        </select>
                    </div>
                </div>
                <% if (!myBookings || myBookings.length === 0) { %>
                    <div class="form-banner form-banner-error">
                        You can only raise a ticket for a booking you've actually made. You don't have any bookings yet.
                    </div>
                <% } %>
                <% } %>
                <div class="form-group">
                    <label for="subject">Subject</label>
                    <input type="text" id="subject" name="subject" placeholder="Briefly summarise the issue" required>
                </div>
                <div class="form-group">
                    <label for="message">Message</label>
                    <textarea id="message" name="message" placeholder="Tell us what happened, including any relevant dates or details." required></textarea>
                </div>
                <div class="form-note">
                    <span class="badge-sla">24H SLA</span>
                    Our support team will get back to you within 24 hours.
                </div>
                <% if (typeof isLoggedIn !== 'undefined' && isLoggedIn) { %>
                    <% const canSubmit = (typeof user !== 'undefined' && user && user.role === 'host') ? (myProperties && myProperties.length > 0) : (myBookings && myBookings.length > 0); %>
                    <button type="submit" class="btn-primary" <%= canSubmit ? '' : 'disabled' %>>Send message</button>
                <% } else { %>
                    <a href="/login" class="btn-primary" style="display:inline-block;text-align:center;text-decoration:none;">Log in to send a message</a>
                <% } %>
            </form>
        </div>
    </div>
</section>

<%- include('partials/footer') %>
</body>
</html>