    <div class="legal-meta-row">
      <span class="legal-meta-item mono">Last updated: 31 Jul 2026</span>
      <span class="legal-meta-item mono">Applies to all users</span>
      <span class="legal-meta-item mono">Governed by Indian law</span>
    </div>
  </div>
