<%- include('../partials/header', { pageTitle: "Favourites" }) %>
<link rel="stylesheet" href="/css/store/favourites.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css">
</head>

<body class="favourites-body">
<%- include('../partials/navbar') %>

<main class="favourites-page">

  <section class="fav-header">
    <div class="fav-header-text">
      <p class="header-mini">SAVED STAYS</p>
      <h1>Your <span id="fav-highlight">Favourites.</span></h1>
      <p class="header-sub">Homes you've loved. Ready when you are.</p>
    </div>
    <div class="fav-header-meta">
      <span class="fav-count">
        <i class="ri-heart-fill"></i>
<%= registeredHomes.length %> saved
      </span>
    </div>
  </section>

<% if (!registeredHomes || registeredHomes.length === 0) { %>
    <div class="empty-state">
      <div class="empty-icon">
        <i class="ri-heart-3-line"></i>
      </div>
      <h2>Nothing saved yet</h2>
      <p>Tap the heart on any home to save it here for later.</p>
      <a href="/homeList" class="empty-btn">
        Browse Homes
        <i class="ri-arrow-right-line"></i>
      </a>
    </div>
    <% } else { %>
    <section class="fav-grid-section">
      <div class="fav-grid">
          <% registeredHomes.forEach(home => { %>
          <div class="fav-card">
            <div class="fav-image">
              <img src="<%= home.photos[0] %>" alt="<%= home.houseName %>">
              <div class="fav-overlay">
                <form action="/favourites/delete/<%= home._id %>" method="POST" class="remove-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="remove-btn" title="Remove from favourites">
                    <i class="ri-heart-fill"></i>
                  </button>
                </form>
              </div>
            </div>
            <div class="fav-content">
              <div class="fav-top">
                <div>
                  <h3><%= home.houseName %></h3>
                  <p class="fav-location">
                    <i class="ri-map-pin-line"></i>
                    <%= home.city %>, <%= home.state %>
                  </p>
                </div>
                <div class="fav-rating">
                  <i class="ri-star-fill"></i>
                  <span>4.9</span>
                </div>
              </div>

              <div class="fav-chips">
                <span class="chip">
                  <i class="ri-hotel-bed-line"></i>
                  <%= home.no_of_bedRooms %> bedrooms
                </span>
                <span class="chip">
                  <i class="ri-home-4-line"></i>
                  <%= home.propertyType %>
                </span>
              </div>

              <div class="fav-footer">
                <div class="fav-price">
                  ₹<%= home.price %>
                  <span>/ night</span>
                </div>
                <div class="fav-actions">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <a href="/homeList/<%= home._id %>" class="btn-bookk">
                    Book now
                  </a>
                </div>
              </div>
            </div>

          </div>
        <% }) %>
      </div>
    </section>

<% } %>

</main>

<div id="removeFavModal" class="cancel-overlay">
  <div class="cancel-modal">
    <div class="cancel-icon"><i class="ri-heart-3-line"></i></div>
    <h2 class="cancel-title">Remove from favourites?</h2>
    <p class="cancel-subtitle">This home will be taken off your saved list. You can always add it back later.</p>
    <div class="cancel-btn-row">
      <button type="button" class="cancel-btn-keep" onclick="closeRemoveFavModal()">Keep It</button>
      <button type="button" class="cancel-btn-confirm" id="removeFavConfirmBtn">Yes, Remove</button>
    </div>
  </div>
</div>

<script>
  let removeFavFormTarget = null;
  document.querySelectorAll('.remove-form').forEach(form => {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      removeFavFormTarget = form;
      document.getElementById('removeFavModal').classList.add('active');
    });
  });
  function closeRemoveFavModal() {
    document.getElementById('removeFavModal').classList.remove('active');
    removeFavFormTarget = null;
  }
  document.getElementById('removeFavConfirmBtn').addEventListener('click', function () {
    if (removeFavFormTarget) {
      removeFavFormTarget.submit();
    }
  });
  document.getElementById('removeFavModal').addEventListener('click', function (e) {
    if (e.target === this) closeRemoveFavModal();
  });

  (function () {
    const PAGE_SIZE = 12;
    const cards = Array.from(document.querySelectorAll('.fav-card'));
    const pagination = document.getElementById('favPagination');
    const section = document.getElementById('favGridSection');
    if (!cards.length || !pagination) return;

    const totalPages = Math.ceil(cards.length / PAGE_SIZE);
    let currentPage = 1;

    function renderControls() {
      if (totalPages <= 1) { pagination.innerHTML = ''; return; }
      let html = `<button type="button" class="fav-page-btn fav-page-prev" ${currentPage === 1 ? 'disabled' : ''} aria-label="Previous page"><i class="ri-arrow-left-s-line"></i></button>`;
      for (let p = 1; p <= totalPages; p++) {
        html += `<button type="button" class="fav-page-btn fav-page-num ${p === currentPage ? 'is-active' : ''}" data-page="${p}">${p}</button>`;
      }
      html += `<button type="button" class="fav-page-btn fav-page-next" ${currentPage === totalPages ? 'disabled' : ''} aria-label="Next page"><i class="ri-arrow-right-s-line"></i></button>`;
      pagination.innerHTML = html;

      pagination.querySelectorAll('.fav-page-num').forEach(btn => {
        btn.addEventListener('click', () => showPage(parseInt(btn.dataset.page, 10), true));
      });
      pagination.querySelector('.fav-page-prev').addEventListener('click', () => {
        if (currentPage > 1) showPage(currentPage - 1, true);
      });
      pagination.querySelector('.fav-page-next').addEventListener('click', () => {
        if (currentPage < totalPages) showPage(currentPage + 1, true);
      });
    }

    function showPage(page, shouldScroll) {
      currentPage = page;
      cards.forEach((card, i) => {
        const cardPage = Math.floor(i / PAGE_SIZE) + 1;
        card.style.display = cardPage === page ? '' : 'none';
      });
      renderControls();
      if (shouldScroll && section) {
        section.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    showPage(1, false);
  })();
</script>
<%- include('../partials/footer') %>
</body>
</html>