<%- include('../partials/header', { pageTitle: home.houseName }) %>

<link rel="stylesheet" href="/css/store/homeDetails.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.2.0/remixicon.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
</head>
<body class="journal-body">
<%- include('../partials/navbar') %>

<main class="journal-page">

  <% const homeTypeMeta = {
      beach:       { label: 'Beach',       icon: 'ri-sun-line',        stamp: 'SEASIDE AIR MAIL' },
      mountain:    { label: 'Mountain',    icon: 'ri-landscape-line',  stamp: 'HIGH ALTITUDE POST' },
      forest:      { label: 'Forest',      icon: 'ri-plant-line',      stamp: 'WOODLAND ROUTE' },
      lake:        { label: 'Lake',        icon: 'ri-drop-line',       stamp: 'LAKESIDE EXPRESS' },
      countryside: { label: 'Countryside', icon: 'ri-leaf-line',       stamp: 'COUNTRY ROAD MAIL' },
      city:        { label: 'City',        icon: 'ri-building-4-line',stamp: 'CITY LINE POST' },
      desert:      { label: 'Desert',      icon: 'ri-sun-foggy-line', stamp: 'DUNE ROUTE MAIL' },
      farm:        { label: 'Farm',        icon: 'ri-seedling-line',  stamp: 'FARMSTEAD POST' },
      cabin:       { label: 'Cabin',       icon: 'ri-snowy-line',     stamp: 'BACKWOODS MAIL' },
      island:      { label: 'Island',      icon: 'ri-compass-3-line',stamp: 'ISLAND FERRY POST' }
    }; %>
  <% const typeInfo = homeTypeMeta[home.homeType] || homeTypeMeta.city; %>
  <% const destCode = (home.city || 'XXX').replace(/[^a-zA-Z]/g,'').substring(0,3).toUpperCase(); %>

  <% const keepsakes = [
      { icon: typeInfo.icon, label: typeInfo.label + ' getaway' },
      { icon: 'ri-hotel-bed-line', label: home.no_of_bedRooms + ' room' + (home.no_of_bedRooms > 1 ? 's' : '') + ' to sleep in' },
      (home.amenities && home.amenities.length)
        ? { icon: 'ri-checkbox-circle-line', label: home.amenities[0] + ' included' }
        : { icon: 'ri-user-line', label: 'sleeps ' + home.maxGuests },
      { icon: 'ri-shield-check-line', label: home.cancellationPolicy + ' cancellation' }
    ]; %>
  <section class="corkboard">
    <div class="corkboard-inner">
      <div class="collage">
        <figure class="polaroid polaroid--hero">
          <div class="polaroid-photo" id="heroPhotoWrap">
            <img src="<%= home.photos[0] %>" alt="<%= home.houseName %>" id="heroPhoto">
            <div class="hero-photo-overlay">
              <form action="/favourites" method="POST" class="wishlist-sticker">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="homeId" value="<%= home._id %>">
                <button type="submit" class="wishlist-btn <%= isFavourite ? 'is-active' : '' %>" aria-label="Save to favourites">
                  <% if (isFavourite) { %><i class="ri-heart-fill"></i><% } else { %><i class="ri-heart-3-line"></i><% } %>
                </button>
              </form>
            </div>
          </div>
          <figcaption>Snap 01 — <%= home.city %></figcaption>
        </figure>

        <% if (home.photos.length > 1) { %>
        <div class="thumb-grid">
          <% home.photos.slice(1).forEach((url, i) => { %>
            <figure class="polaroid polaroid--thumb gallery-thumb" data-index="<%= i + 1 %>">
              <div class="polaroid-photo"><img src="<%= url %>" alt="<%= home.houseName %>"></div>
              <figcaption>Snap 0<%= i + 2 %></figcaption>
            </figure>
          <% }) %>
        </div>
        <% } %>
      </div>

      <div class="postcard-tag">
        <span class="postmark mono"><%= destCode %><br><%= typeInfo.label %></span>

        <p class="breadcrumb">
          <a href="/homeList">Homes</a> <span>&rsaquo;</span>
          <a href="/homeList?location=<%= home.state %>"><%= home.state %></a>
        </p>

        <p class="postcard-eyebrow">Wish you were here —</p>
        <h1><%= home.houseName %></h1>
        <p class="title-location"><i class="ri-map-pin-line"></i><%= home.city %>, <%= home.state %></p>

        <ul class="packing-list">
          <li><span class="mono">Rate</span><strong>&#8377;<%= home.price %> / night</strong></li>
          <li><span class="mono">Crew</span><strong>up to <%= home.maxGuests %> guests</strong></li>
          <li><span class="mono">Beds</span><strong><%= home.no_of_bedRooms %> room<%= home.no_of_bedRooms > 1 ? 's' : '' %></strong></li>
          <li><span class="mono">Rated</span><strong><%= home.reviewCount > 0 ? home.avgRating + ' / 5' : 'no reviews yet' %></strong></li>
        </ul>

        <button class="stamp-btn" onclick="document.getElementById('booking').scrollIntoView({behavior:'smooth'})">
          Check the dates <i class="ri-arrow-right-up-line"></i>
        </button>
      </div>
    </div>

    <div class="keepsake-line">
      <% keepsakes.forEach(k => { %>
        <span class="keepsake-item"><i class="<%= k.icon %>"></i><%= k.label %></span>
      <% }) %>
    </div>
  </section>

  <script type="application/json" id="home-photos-data"><%- JSON.stringify(home.photos) %></script>

  <div class="lightbox" id="lightbox">
    <button class="lightbox-close" id="lightboxClose"><i class="ri-close-line"></i></button>
    <button class="lightbox-nav lightbox-prev" id="lightboxPrev"><i class="ri-arrow-left-s-line"></i></button>
    <img class="lightbox-img" id="lightboxImg" src="" alt="">
    <button class="lightbox-nav lightbox-next" id="lightboxNext"><i class="ri-arrow-right-s-line"></i></button>
    <div class="lightbox-counter mono" id="lightboxCounter"></div>
  </div>
  <nav class="journal-tabs">
    <a href="#overview" class="active">Notes</a>
    <a href="#amenities">Kit</a>
    <a href="#location">Map</a>
    <a href="#rules">House rules</a>
    <a href="#reviews">Postcards</a>
    <a href="#host">Your host</a>
  </nav>

  <div class="journal-body-grid">
    <div class="journal-content">

      <section class="notecard" id="overview">
        <span class="paperclip"></span>
        <p class="tab-label mono">field notes</p>
        <p class="about-type-line"><i class="<%= typeInfo.icon %>"></i> A <%= typeInfo.label.toLowerCase() %> stay in <%= home.city %>, <%= home.state %></p>
        <p class="typed-text"><%= home.description %></p>
      </section>

      <section id="amenities">
        <p class="tab-label mono">what's in the kit</p>
        <h2 class="section-heading">Amenities</h2>
        <% const amenityIcons = {
            "WiFi": "ri-wifi-line", "Kitchen": "ri-fire-line",
            "Free parking": "ri-parking-box-line", "Pool": "ri-drop-line",
            "Air conditioning": "ri-snowy-line", "Washer": "ri-t-shirt-line",
            "TV": "ri-tv-2-line", "Heating": "ri-fire-fill",
            "Dedicated workspace": "ri-briefcase-line", "Pet friendly": "ri-footprint-line"
          }; %>
        <% if (home.amenities && home.amenities.length > 0) { %>
          <div class="sticker-route">
            <% home.amenities.forEach(function(item){ %>
              <span class="sticker"><i class="<%= amenityIcons[item] || 'ri-checkbox-circle-line' %>"></i><%= item %></span>
            <% }); %>
          </div>
        <% } else { %>
          <p class="muted-note">Nothing packed in this kit yet.</p>
        <% } %>
      </section>

      <section id="location">
        <p class="tab-label mono">where to find it</p>
        <h2 class="section-heading">Location</h2>
        <div class="location-grid">
          <div class="map-postcard">
            <% if (home.lat && home.lng) { %>
              <div class="map-frame">
                <div id="leafletMap" style="height:280px;"></div>
                <span class="postmark-stamp mono">POSTED<br><%= destCode %></span>
              </div>
              <a class="map-directions-link" href="https://www.google.com/maps/dir/?api=1&destination=<%= home.lat %>,<%= home.lng %>" target="_blank" rel="noopener">
                <i class="ri-navigation-line"></i> Get directions
              </a>
            <% } else { %>
              <div class="map-placeholder">
                <div class="pin-pulse"></div>
                <div class="pin-dot"></div>
                <span class="mono">exact pin dropped after booking</span>
              </div>
            <% } %>
          </div>
          <ul class="location-info">
            <% if (home.addressLine1) { %>
              <li><i class="ri-home-3-line"></i><span><%= home.addressLine1 %><%= home.addressLine2 ? ', ' + home.addressLine2 : '' %></span></li>
              <li><i class="ri-building-4-line"></i><span><%= home.city %>, <%= home.state %> - <%= home.pincode %></span></li>
              <li><i class="ri-earth-line"></i><span><%= home.country %></span></li>
            <% } else { %>
              <li><i class="ri-map-pin-line"></i><span><%= home.location %></span></li>
            <% } %>
            <li><i class="<%= typeInfo.icon %>"></i><span><%= typeInfo.label %> surroundings</span></li>
          </ul>
        </div>
      </section>

      <section id="rules">
        <p class="tab-label mono">before you check in</p>
        <h2 class="section-heading">House rules</h2>
        <ol class="notepad-list">
          <li><i class="ri-login-box-line"></i><div><h4>Arrive</h4><p>after <%= home.checkInTime %></p></div></li>
          <li><i class="ri-logout-box-line"></i><div><h4>Leave</h4><p>before <%= home.checkOutTime %></p></div></li>
          <li><i class="ri-group-line"></i><div><h4>Guests</h4><p>up to <%= home.maxGuests %></p></div></li>
          <li><i class="<%= home.amenities && home.amenities.includes('Pet friendly') ? 'ri-footprint-line' : 'ri-forbid-line' %>"></i><div><h4>Pets</h4><p><%= home.amenities && home.amenities.includes('Pet friendly') ? 'welcome' : 'not this time' %></p></div></li>
          <li><i class="ri-volume-mute-line"></i><div><h4>Quiet hours</h4><p>10 PM – 8 AM</p></div></li>
          <li><i class="ri-forbid-2-line"></i><div><h4>Parties</h4><p>please don't</p></div></li>
        </ol>
        <div class="washi-note">
          <span class="tape"></span>
          <h4><%= home.cancellationPolicy.charAt(0).toUpperCase() + home.cancellationPolicy.slice(1) %> cancellation</h4>
          <% if (home.cancellationPolicy === 'flexible') { %>
            <p>Full refund if you cancel at least 24 hours before check-in.</p>
          <% } else if (home.cancellationPolicy === 'moderate') { %>
            <p>Full refund if you cancel at least 5 days before check-in.</p>
          <% } else { %>
            <p>50% refund up to 7 days before check-in. No refund after that.</p>
          <% } %>
        </div>
      </section>

      <section id="reviews">
        <p class="tab-label mono">mail from past guests</p>
        <div class="reviews-header">
          <h2 class="section-heading" style="margin-bottom:0;">Postcards</h2>
          <% if (home.reviewCount > 0) { %>
            <span class="rating-pill mono"><i class="ri-star-fill"></i><strong><%= home.avgRating %></strong> · <%= home.reviewCount %> received</span>
          <% } else { %>
            <span class="muted-note">No postcards yet — be the first to send one</span>
          <% } %>
        </div>

        <% if (reviews.length === 0) { %>
          <p class="muted-note">Nothing in the mailbox yet. Stay here and leave the first note.</p>
        <% } else { %>
          <div class="postcard-stack">
            <% reviews.forEach((review, ri) => { %>
              <article class="review-postcard">
                <span class="stamp-corner mono">
                  <% for(let i = 1; i <= 5; i++) { %><i class="ri-star-<%= i <= review.rating ? 'fill' : 'line' %>"></i><% } %>
                </span>
                <div class="review-top">
                  <img src="<%= review.guest.profileImage %>" alt="<%= review.guest.fname %>">
                  <div>
                    <p class="who"><%= review.guest.fname %> <%= review.guest.lname %></p>
                    <p class="when mono"><%= new Date(review.createdAt).toLocaleDateString('en-IN', {month:'long', year:'numeric'}) %></p>
                  </div>
                </div>
                <p class="comment"><%= review.comment %></p>
                <% if (review.hostReply && review.hostReply.comment) { %>
                  <div class="host-reply">
                    <strong>Host wrote back</strong>
                    <p><%= review.hostReply.comment %></p>
                    <small class="mono"><%= new Date(review.hostReply.repliedAt).toLocaleDateString() %></small>
                  </div>
                <% } %>
                <% if (locals.user && locals.user.role === 'host' &&
                    home.owner._id.toString() === locals.user._id.toString() &&
                      !(review.hostReply && review.hostReply.comment)) { %>
                    <form action="/reviews/reply/<%= review._id %>?_method=POST" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <textarea name="comment" placeholder="Write back..." required minlength="2" maxlength="1000"></textarea>
                        <button type="submit">Send reply</button>
                    </form>
                <% } %>
              </article>
            <% }) %>
          </div>
        <% } %>
      </section>

      <section class="host-section" id="host">
        <p class="tab-label mono">who you're staying with</p>
        <div class="host-section-grid">
          <a href="/hosts?host=<%= home.owner._id %>" class="host-id-card">
            <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
            <img src="<%= home.owner.profileImage %>" alt="<%= home.owner.fname %>">
            <p class="operator-tag mono">Your host</p>
            <h3><%= home.owner.fname %> <%= home.owner.lname %></h3>
            <p class="host-bio"><%= home.owner.bio || '' %></p>
            <p class="host-meta"><%= home.owner.location %></p>
            <p class="host-meta"><%= home.owner.stays %> stays hosted</p>
          </a>
          <% if (hostOtherHomes.length > 0) { %>
            <div class="host-other-homes-col">
              <h4>More from <%= home.owner.fname %></h4>
              <div class="host-other-homes">
                <% hostOtherHomes.forEach(h => { %>
                  <a href="/homeList/<%= h._id %>" class="mini-polaroid">
                    <div class="polaroid-photo"><img src="<%= h.photos[0] %>" alt="<%= h.houseName %>"></div>
                    <p class="mini-name"><%= h.houseName %></p>
                    <p class="mini-price mono">&#8377;<%= h.price %>/night · <%= h.no_of_bedRooms %> beds</p>
                  </a>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>
      </section>

    </div>

    <aside class="ticket" id="booking">
      <div class="ticket-clip"></div>
      <div class="ticket-top">
        <span class="mono">BOARDING PASS</span>
        <span class="mono">SEAT <%= destCode %>-<%= String(home.no_of_bedRooms).padStart(2,'0') %></span>
      </div>

      <div class="ticket-price">
        <h2>&#8377;<%= home.price %> <span>/ night</span></h2>
        <p class="booking-rating mono"><i class="ri-star-fill"></i><%= home.reviewCount > 0 ? home.avgRating : 'Unrated' %></p>
      </div>

      <div class="ticket-fields">
        <label>Depart<input type="date" id="checkIn" min="<%= new Date().toISOString().split('T')[0] %>"></label>
        <label>Return<input type="date" id="checkOut" min="<%= new Date().toISOString().split('T')[0] %>"></label>
        <label>Guests <span class="guest-max-note">(max <%= home.maxGuests %>)</span>
          <select id="guestsSelect">
            <% for (let g = 1; g <= (home.maxGuests || 4); g++) { %>
              <option value="<%= g %>"><%= g %> guest<%= g > 1 ? 's' : '' %></option>
            <% } %>
          </select>
        </label>
      </div>

      <div class="ticket-perforation"></div>

      <div class="ticket-stub">
        <div id="availResult" class="mono" style="display:none;"></div>
        <div id="priceBreakdown" class="mono" style="display:none;">
          <div class="stub-row"><span id="nightsLabel"></span><span id="nightsTotal"></span></div>
          <div class="stub-row stub-total"><span>Total</span><span id="grandTotal"></span></div>
        </div>
        <button class="stamp-btn stamp-btn--wide" id="checkBtn" onclick="checkAvailability()">Check availability</button>
        <button class="stamp-btn stamp-btn--wide stamp-btn--go" id="bookBtn" style="display:none;" onclick="startPayment()">
          Confirm trip — pay &#8377;<span id="payAmount"></span>
        </button>
        <p class="booking-note"><i class="ri-information-line"></i> Nothing is charged until you confirm</p>
      </div>
    </aside>
  </div>
</main>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
  const HOME_ID    = "<%= home._id %>";
  const IS_LOGGED  = "<%= locals.isLoggedIn ? 'true' : 'false' %>";
  const USER_NAME  = "<%= locals.user ? (user.fname + ' ' + user.lname) : '' %>";
  const USER_EMAIL = "<%= locals.user ? user.email : '' %>";
  const CSRF_TOKEN = "<%= csrfToken %>";
  let _nights = 0, _total = 0;
  async function checkAvailability() {
    const checkIn  = document.getElementById('checkIn').value;
    const checkOut = document.getElementById('checkOut').value;
    const priceBox = document.getElementById('priceBreakdown');
    const bookBtn  = document.getElementById('bookBtn');

    if (!checkIn || !checkOut) {
      showResult('Pick both a departure and return date.', '#fdf1d6', '#7a5a12');
      return;
    }

    const res  = await fetch(`/bookings/check-availability?homeId=${HOME_ID}&checkIn=${checkIn}&checkOut=${checkOut}`);
    const data = await res.json();

    if (data.available) {
      _nights = data.nights;
      _total  = data.totalPrice;
      document.getElementById('nightsLabel').textContent = `${data.nights} night${data.nights > 1 ? 's' : ''} (avg ₹${Math.round(data.totalPrice / data.nights)}/night)`;
      document.getElementById('nightsTotal').textContent = `₹${data.totalPrice}`;
      document.getElementById('grandTotal').textContent  = `₹${data.totalPrice}`;
      document.getElementById('payAmount').textContent   = data.totalPrice;
      priceBox.style.display = 'block';
      bookBtn.style.display  = 'block';
      showResult('✓ These dates are free!', '#e4f2e1', '#2f5d33');
    } else {
      priceBox.style.display = 'none';
      bookBtn.style.display  = 'none';
      showResult('✗ Already booked for these dates. Try another window.', '#fbe3e0', '#8f2f24');
    }
  }

  function showResult(msg, bg, color) {
    const el = document.getElementById('availResult');
    el.style.display    = 'block';
    el.style.background = bg;
    el.style.color      = color;
    el.style.padding    = '10px 14px';
    el.textContent      = msg;
  }

  async function startPayment() {
    if (!IS_LOGGED) {
      window.location.href = '/login';
      return;
    }

    const checkIn  = document.getElementById('checkIn').value;
    const checkOut = document.getElementById('checkOut').value;
    const guests   = document.getElementById('guestsSelect').value;

    const res  = await fetch('/bookings/create-order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'CSRF-Token': CSRF_TOKEN },
      body: JSON.stringify({ homeId: HOME_ID, checkIn, checkOut, guests })
    });
    const order = await res.json();
    if (order.error) { alert(order.error); return; }

    const options = {
      key:         order.keyId,
      amount:      order.amount,
      currency:    order.currency,
      name:        "Roovia",
      description: order.homeName,
      order_id:    order.orderId,
      theme: { color: "#C1503E" },
      handler: async function(response) {
        const verifyRes = await fetch('/bookings/verify-payment', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'CSRF-Token': CSRF_TOKEN },
          body: JSON.stringify({
              razorpay_order_id:   response.razorpay_order_id,
              razorpay_payment_id: response.razorpay_payment_id,
              razorpay_signature:  response.razorpay_signature,
              homeId: HOME_ID,
              checkIn, checkOut, guests,
              totalPrice: _total,
              nights:     _nights
          })
        });
        const result = await verifyRes.json();
        if (result.success) {
          window.location.href = '/bookings/confirmation/' + result.bookingId;
        } else {
          alert('Payment verification failed. Contact support.');
        }
      },
      prefill: { name: USER_NAME, email: USER_EMAIL }
    };

    const rzp = new Razorpay(options);
    rzp.open();
  }
  const backBtn = document.getElementById('backToHomes');
  if (backBtn) {
    const saved = sessionStorage.getItem('homeListFilters');
    if (saved) backBtn.href = '/homeList?' + saved;
  }
</script>

<% if (home.lat && home.lng) { %>
<script type="application/json" id="home-geo-data"><%- JSON.stringify({
  lat: home.lat,
  lng: home.lng,
  name: home.houseName
}) %></script>
<script>
  (function () {
    const geoEl = document.getElementById('home-geo-data');
    if (!geoEl) return;
    const geo = JSON.parse(geoEl.textContent);
    const map = L.map('leafletMap', { scrollWheelZoom: false, zoomControl: false }).setView([geo.lat, geo.lng], 14);
    L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
      attribution: '&copy; OpenStreetMap contributors &copy; <a href="https://carto.com/attributions">CARTO</a>',
      subdomains: 'abcd',
      maxZoom: 19
    }).addTo(map);
    L.control.zoom({ position: 'bottomright' }).addTo(map);
    const pinIcon = L.divIcon({
      className: 'custom-map-pin',
      html: '<div class="pin-dot"></div><div class="pin-pulse"></div>',
      iconSize: [22, 22],
      iconAnchor: [11, 11]
    });
    L.marker([geo.lat, geo.lng], { icon: pinIcon }).addTo(map)
      .bindPopup(`
        <div class="map-popup">
          <strong>${geo.name}</strong>
          <a href="https://www.google.com/maps/dir/?api=1&destination=${geo.lat},${geo.lng}" target="_blank" rel="noopener">Get directions →</a>
        </div>
      `);
    const mapEl = document.getElementById('leafletMap');
    mapEl.addEventListener('click', () => map.scrollWheelZoom.enable(), { once: true });
    mapEl.addEventListener('mouseleave', () => map.scrollWheelZoom.disable());
  })();

  (function () {
    const dataEl = document.getElementById('home-photos-data');
    if (!dataEl) return;
    const photos = JSON.parse(dataEl.textContent);
    if (!photos.length) return;

    const lightbox   = document.getElementById('lightbox');
    const lbImg       = document.getElementById('lightboxImg');
    const lbCounter    = document.getElementById('lightboxCounter');
    let currentIndex = 0;

    function openLightbox(index) {
      currentIndex = index;
      updateLightbox();
      lightbox.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeLightbox() {
      lightbox.classList.remove('open');
      document.body.style.overflow = '';
    }
    function updateLightbox() {
      lbImg.src = photos[currentIndex];
      lbCounter.textContent = `${currentIndex + 1} / ${photos.length}`;
    }
    function showNext() { currentIndex = (currentIndex + 1) % photos.length; updateLightbox(); }
    function showPrev() { currentIndex = (currentIndex - 1 + photos.length) % photos.length; updateLightbox(); }

    document.getElementById('heroPhoto')?.addEventListener('click', () => openLightbox(0));
    document.querySelectorAll('.gallery-thumb').forEach(thumb => {
      thumb.addEventListener('click', () => openLightbox(parseInt(thumb.dataset.index, 10)));
    });

    document.getElementById('lightboxClose').addEventListener('click', closeLightbox);
    document.getElementById('lightboxNext').addEventListener('click', showNext);
    document.getElementById('lightboxPrev').addEventListener('click', showPrev);
    lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });
    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('open')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'ArrowLeft') showPrev();
    });
  })();

  (function () {
    const tabLinks = document.querySelectorAll('.journal-tabs a');
    const sections = Array.from(tabLinks).map(link => document.querySelector(link.getAttribute('href'))).filter(Boolean);

    function setActive(id) {
      tabLinks.forEach(link => link.classList.toggle('active', link.getAttribute('href') === '#' + id));
    }
    tabLinks.forEach(link => {
      link.addEventListener('click', () => setActive(link.getAttribute('href').slice(1)));
    });
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => { if (entry.isIntersecting) setActive(entry.target.id); });
    }, { rootMargin: '-160px 0px -60% 0px', threshold: 0 });
    sections.forEach(sec => observer.observe(sec));
  })();
</script>
<% } %>
<%- include('../partials/footer') %>
</body>
</html>