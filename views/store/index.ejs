<%- include('../partials/header', { pageTitle: "Roovia — Off-grid stays" }) %>
<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css">
</head>

<body class="home-body">
<%- include('../partials/navbar') %>

<% 

const featuredHomes = (registeredHomes && registeredHomes.length ? registeredHomes : [
  { houseName: "Sunset Villa",     location: "Goa",       city: "Goa",       state: "Goa",           photo: "/images/placeholder1.jpg", price: 4500, no_of_bedRooms: 2, avgRating: 4.8, reviewCount: 12, _id: "demo1" },
  { houseName: "Pine Cabin",       location: "Coorg",     city: "Coorg",     state: "Karnataka",     photo: "/images/placeholder2.jpg", price: 3200, no_of_bedRooms: 1, avgRating: 4.6, reviewCount: 8,  _id: "demo2" },
  { houseName: "The Glass House",  location: "Rishikesh", city: "Rishikesh", state: "Uttarakhand",   photo: "/images/placeholder3.jpg", price: 5100, no_of_bedRooms: 3, avgRating: 4.9, reviewCount: 21, _id: "demo3" },
  { houseName: "Hillside Cottage", location: "Manali",    city: "Manali",    state: "Himachal Pradesh", photo: "/images/placeholder4.jpg", price: 3800, no_of_bedRooms: 2, avgRating: 4.7, reviewCount: 15, _id: "demo4" }
]).slice(0, 4);
%>

<main class="home-page">
  <section class="spotlight-hero" id="spotlightHero">
    <div class="spotlight-grid-bg"></div>
    <div class="spotlight-content">
      <div class="hero-text">
          <p class="hero-mini">OFF-GRID STAYS</p>
          <h1 class="spotlight-title">Handpicked homes. <span>Timeless stays.</span></h1>
          <p class="spotlight-sub">
            <span id="typewriterText"></span><span class="typewriter-cursor">|</span>
          </p>
        </div>
      <div class="spotlight-actions">
        <a href="/homeList" class="btn-primary" id="heroCta">
          <span class="cta-label">Browse all stays</span>
        </a>
        <a href="/host" class="btn-ghost">List your place</a>
      </div>
    </div>
    <div class="ember-zone" id="emberZone">
      <div class="ember-annot ember-annot-left">
        <span class="ember-annot-text">Every stay,<br>real and live</span>
        <svg class="ember-annot-arrow" viewBox="0 0 70 50"><path d="M8 8 Q35 6 62 44" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/><polygon points="57,41 65,48 56,44" fill="currentColor"/></svg>
      </div>
      <div class="ember-annot ember-annot-right">
        <svg class="ember-annot-arrow ember-annot-arrow-flip" viewBox="0 0 70 50"><path d="M62 8 Q35 6 8 44" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/><polygon points="13,41 5,48 14,44" fill="currentColor"/></svg>
        <span class="ember-annot-text">Picked for<br>silence &amp; stars</span>
      </div>
      <div class="ember-device" id="emberDevice">
        <div class="ember-chrome">
          <span class="chrome-dot red"></span>
          <span class="chrome-dot yellow"></span>
          <span class="chrome-dot green"></span>
          <span class="chrome-url mono" id="emberUrl">roovia.app/goa-treehouse</span>
          <span class="chrome-live mono"><span class="n-pulse good"></span> LIVE</span>
        </div>
        <div class="ember-scene">
          <img class="ember-photo ember-photo-a is-active"
            src="https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=1400&q=80"
            alt="A treehouse stay under the night sky">
          <img class="ember-photo ember-photo-b"
            alt="A stay at Roovia">
          <canvas id="emberCanvas" class="ember-canvas"></canvas>
          <div class="ember-vignette"></div>
          <div class="ember-pin pin-1 mono">off-grid ✓</div>
          <div class="ember-pin pin-2 mono">3km to town</div>
          <div class="ember-pin pin-3 mono">★ 4.9 rated</div>
        </div>
        <div class="ember-footer mono">
          <span id="emberCaption">Goa Treehouse — night view</span>
          <span class="ember-footer-brand">by roovia ✦</span>
        </div>
      </div>
    </div>
  </section>

  <section class="globe-section" id="globeSection">
    <div class="globe-glow"></div>
    <div class="globe-layout">
      <div class="globe-copy">
        <p class="hero-mini">WHERE WE ARE</p>
        <h2 class="globe-heading">One network. <span>Every horizon.</span></h2>
        <p class="section-sub globe-sub">
          From Himalayan cabins to island treehouses — every Roovia stay,
          one connected map.
        </p>
        <div class="globe-destinations">
          <% featuredHomes.slice(0, 4).forEach(home => { %>
            <a href="/homeList/<%= home._id %>" class="globe-dest">
              <span class="globe-dest-dot"></span>
              <span class="globe-dest-name">
                <% if (home.city && home.state) { %>
                  <%= home.city %>, <%= home.state %>
                <% } else { %>
                  <%= home.location %>
                <% } %>
              </span>
              <span class="globe-dest-tag mono"><%= home.houseName %></span>
            </a>
          <% }) %>
        </div>
        <div class="globe-stats-row">
          <div class="globe-stat">
            <span class="globe-stat-val mono">7</span>
            <span class="globe-stat-label">Continents</span>
          </div>
          <div class="globe-stat-divider"></div>
          <div class="globe-stat">
            <span class="globe-stat-val mono">41+</span>
            <span class="globe-stat-label">Stays live</span>
          </div>
          <div class="globe-stat-divider"></div>
          <div class="globe-stat">
            <span class="globe-stat-val mono">10</span>
            <span class="globe-stat-label">Regions mapped</span>
          </div>
        </div>
      </div>
      <div class="globe-visual">
        <div class="globe-wrap" id="globeWrap">
          <canvas id="globeCanvas" class="globe-canvas"></canvas>
        </div>
      </div>
    </div>
  </section>

  <section class="featured-section" id="featured">
    <div class="section-heading">
      <p class="hero-mini">THE COLLECTION</p>
      <h2>Stay close to what <span>matters.</span></h2>
      <p class="section-sub">A handful of homes we can't stop recommending.</p>
    </div>
    <% if (!featuredHomes || featuredHomes.length === 0) { %>
      <div class="featured-empty">
        <i class="ri-home-3-line"></i>
        <h3>No stays listed yet</h3>
        <p>Check back soon — new homes are added regularly.</p>
      </div>
    <% } else { %>
      <div class="featured-grid">
        <% featuredHomes.forEach(home => { %>
          <a href="/homeList/<%= home._id %>" class="feature-card">
            <div class="feature-card-image">
              <img src="<%= (home.photos && home.photos[0]) || home.photo %>"
                onerror="this.onerror=null;this.src='https://picsum.photos/seed/<%= home._id %>/600/500';"
                alt="<%= home.houseName %>">
              <div class="feature-rating mono">
                <i class="ri-star-fill"></i>
                <%= (home.reviewCount && home.reviewCount > 0) ? home.avgRating : 'New' %>
              </div>
            </div>
            <div class="feature-card-body">
              <p class="feature-location mono">
                <% if (home.city && home.state) { %>
                  <%= home.city %>, <%= home.state %>
                <% } else { %>
                  <%= home.location %>
                <% } %>
              </p>
              <h3 class="feature-name"><%= home.houseName %></h3>
              <div class="feature-footer">
                <p class="feature-price mono">₹<%= home.price %> <span>/ night</span></p>
                <p class="feature-beds mono">
                  <i class="ri-hotel-bed-line"></i>
                  <%= home.no_of_bedRooms %><%= home.no_of_bedRooms > 1 ? ' beds' : ' bed' %>
                </p>
              </div>
            </div>
          </a>
        <% }) %>
      </div>
    <% } %>
    <div class="featured-cta-wrap">
      <a href="/homeList" class="btn-ghost">
        Discover more stays <i class="ri-arrow-right-line"></i>
      </a>
    </div>
  </section>

  <section class="why-section" id="whySection">
    <div class="why-bg">
      <img src="https://images.unsplash.com/photo-1449158743715-0a90ebb6d2d8?auto=format&fit=crop&w=1600&q=80" alt="">
    </div>
    <div class="why-bg-overlay"></div>
    <div class="section-heading">
      <p class="hero-mini">WHY ROOVIA</p>
      <h2>Not a compromise. <span>A choice.</span></h2>
    </div>
    <div class="why-orbit-wrap">
      <div class="why-orbit-ring"></div>
      <div class="why-device">
        <div class="why-device-chrome">
          <span class="chrome-dot red"></span>
          <span class="chrome-dot yellow"></span>
          <span class="chrome-dot green"></span>
          <span class="chrome-url mono">roovia.app/goa-treehouse</span>
        </div>
        <div class="why-device-body">
          <div class="why-zone why-zone-photo" data-zone="photo">
            <img src="https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=700&q=80" alt="">
            <span class="why-zone-tag mono">verified photo</span>
          </div>
          <div class="why-zone-row">
            <div class="why-zone why-zone-location" data-zone="location">
              <i class="ri-leaf-line"></i>
              <span>Off-grid · Coorg</span>
            </div>
            <div class="why-zone why-zone-host" data-zone="host">
              <i class="ri-user-3-line"></i>
              <span>Hosted by Aditi</span>
            </div>
          </div>
        </div>
      </div>
      <div class="why-float why-float-1" data-target="photo">
        <div class="why-icon"><i class="ri-camera-line"></i></div>
        <h3>Real photos only</h3>
        <p>What you see is what you get — every photo is the actual stay, shot in real light.</p>
      </div>
      <div class="why-float why-float-2" data-target="location">
        <div class="why-icon"><i class="ri-leaf-line"></i></div>
        <h3>Off-grid by design</h3>
        <p>Every listing is picked for stillness and space, not proximity to a highway.</p>
      </div>
      <div class="why-float why-float-3" data-target="host">
        <div class="why-icon"><i class="ri-user-heart-line"></i></div>
        <h3>Hosted by locals</h3>
        <p>No corporate property managers — every home is owned and run by the person who built it.</p>
      </div>
    </div>
  </section>

  <section class="host-banner">
    <div class="host-banner-inner">
      <div class="host-banner-copy">
        <p class="hero-mini">FOR HOSTS</p>
        <h2>Have a place worth<br><span class="host-banner-highlight">slowing down in?</span></h2>
        <p class="section-sub host-banner-sub">
          List it on Roovia — no listing fees, no corporate red tape.
          Every host runs their own stay, on their own terms.
        </p>
        <a href="/host" class="btn-primary">
          <span class="cta-label">Start hosting</span>
        </a>
        <div class="host-proof-row">
          <div class="host-proof-chip">
            <i class="ri-home-4-line"></i>
            <div>
              <p class="host-proof-title">41+ hosts</p>
              <p class="host-proof-meta mono">already listed, zero fees</p>
            </div>
          </div>
          <div class="host-proof-chip">
            <i class="ri-star-fill"></i>
            <div>
              <p class="host-proof-title">4.8 avg rating</p>
              <p class="host-proof-meta mono">across all Roovia stays</p>
            </div>
          </div>
        </div>
      </div>
      <div class="host-banner-visual">
        <div class="host-photo-frame">
          <img src="/images/shubhayan.png" alt="A Roovia host">
          <div class="host-photo-overlay"></div>
        </div>
        <div class="host-badge badge-1">
          <i class="ri-map-pin-line"></i> Host based in Coorg
        </div>
        <div class="host-badge badge-2">
          <i class="ri-home-heart-line"></i> Owner &amp; host since 2021
        </div>
        <div class="host-badge badge-3">
          <i class="ri-verified-badge-line"></i> Verified Roovia host
        </div>
      </div>
    </div>
  </section>

