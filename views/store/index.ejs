            <img src="https://i.pravatar.cc/100?img=32">
            <div><h4>Riya Sharma</h4><span class="mono">Delhi</span></div>
          </div>
        </div>
        <div class="testimonial-card"
          data-name="Sana Khan" data-location="Hyderabad"
          data-role="Freelance Illustrator" data-company="Self-employed"
