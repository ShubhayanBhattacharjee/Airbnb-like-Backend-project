<script>
  (function () {
    const el = document.getElementById('liveCount');
    if (!el) return;
    let count = 23;
    setInterval(() => {
      const delta = Math.floor(Math.random() * 3) - 1;
      count = Math.min(34, Math.max(18, count + delta));
      el.textContent = count;
    }, 4000);
  })();

  (function () {
    const el = document.getElementById('scrollIndicator');
    if (!el) return;
    el.addEventListener('click', () => {
      document.getElementById('featured').scrollIntoView({ behavior: 'smooth' });
    });
    window.addEventListener('scroll', () => {
      el.style.opacity = 1 - Math.min(window.scrollY / 150, 1);
    });
  })();

  (function () {
    const track = document.getElementById('testimonialTrack');
    if (!track) return;
    let reversed = false;
    setInterval(() => {
      reversed = !reversed;
      track.classList.toggle('reverse', reversed);
    }, 32000);
  })();

  (function () {
    const zone = document.getElementById('emberZone');
    const device = document.getElementById('emberDevice');
    if (!zone || !device) return;
    let targetX = 0, targetY = 0;
    let curX = 0, curY = 0;
    zone.addEventListener('mousemove', (e) => {
      const r = zone.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      targetX = ((e.clientY - cy) / r.height) * -6;
      targetY = ((e.clientX - cx) / r.width) * 8;
    });
    zone.addEventListener('mouseleave', () => { targetX = 0; targetY = 0; });
    function loop() {
      curX += (targetX - curX) * 0.06;
      curY += (targetY - curY) * 0.06;
      device.style.transform = `perspective(1400px) rotateX(${curX}deg) rotateY(${curY}deg)`;
      requestAnimationFrame(loop);
    }
    requestAnimationFrame(loop);
  })();

  (function () {
    const canvas = document.getElementById('emberCanvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    function resize() {
      canvas.width = canvas.offsetWidth;
      canvas.height = canvas.offsetHeight;
    }
    resize();
    window.addEventListener('resize', resize);
    function spawnEmber() {
      return {
        x: Math.random() * canvas.width,
        y: canvas.height + Math.random() * 80,
        r: Math.random() * 2.4 + 0.5,
        speed: Math.random() * 0.9 + 0.3,
        sway: Math.random() * 1.1 + 0.3,
        swayOffset: Math.random() * Math.PI * 2,
        swaySpeed: Math.random() * 0.6 + 0.6,
        flicker: Math.random() * Math.PI * 2,
        life: Math.random() * 0.7 + 0.3,
      };
    }
    const embers = Array.from({ length: 55 }, spawnEmber);
    let reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) return;
    function tick(t) {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      embers.forEach((p) => {
        p.y -= p.speed;
        const swayX = Math.sin((t / 1000) * p.swaySpeed + p.swayOffset) * p.sway * 14;
        const flicker = 0.6 + Math.sin(t / 300 + p.flicker) * 0.4;
        const alpha = Math.max(0, (p.y / canvas.height) * p.life * flicker);
        ctx.beginPath();
        ctx.arc(p.x + swayX, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255,106,26,${alpha})`;
        ctx.shadowColor = 'rgba(255,106,26,0.7)';
        ctx.shadowBlur = 8;
        ctx.fill();
        ctx.shadowBlur = 0;
        if (p.y < -10) Object.assign(p, spawnEmber(), { y: canvas.height + 10 });
      });
      requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  })();

  (function () {
    const imgA = document.querySelector('.ember-photo-a');
    const imgB = document.querySelector('.ember-photo-b');
    const urlEl = document.getElementById('emberUrl');
    const captionEl = document.getElementById('emberCaption');
    if (!imgA || !imgB || !urlEl || !captionEl) return;
    const stays = [
      {
        photo: 'https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?auto=format&fit=crop&w=1400&q=80',
        url: 'roovia.app/goa-treehouse',
        caption: 'Goa Treehouse — night view',
      },
      {
        photo: 'https://images.unsplash.com/photo-1476041800959-2f6bb412c8ce?auto=format&fit=crop&w=1400&q=80',
        url: 'roovia.app/coorg-pine-cabin',
        caption: 'Pine Cabin, Coorg — misty morning',
      },
      {
        photo: 'https://images.unsplash.com/photo-1449158743715-0a90ebb6d2d8?auto=format&fit=crop&w=1400&q=80',
        url: 'roovia.app/rishikesh-glass-house',
        caption: 'The Glass House, Rishikesh — riverside',
      },
      {
        photo: 'https://images.unsplash.com/photo-1518602164578-cd0074062767?auto=format&fit=crop&w=1400&q=80',
        url: 'roovia.app/manali-hillside-cottage',
        caption: 'Hillside Cottage, Manali — golden hour',
      },
    ];
    let index = 0;
    let showingA = true;
    const INTERVAL = 6000;
    stays.forEach((s) => { const im = new Image(); im.src = s.photo; });
    function swapText(el, newText) {
      el.style.transition = 'opacity .5s ease';
      el.style.opacity = 0;
      setTimeout(() => {
        el.textContent = newText;
        el.style.opacity = 1;
      }, 500);
    }
    function next() {
      index = (index + 1) % stays.length;
      const stay = stays[index];
      const incoming = showingA ? imgB : imgA;
      const outgoing = showingA ? imgA : imgB;
      incoming.src = stay.photo;
      incoming.onload = () => {
        incoming.classList.add('is-active');
        outgoing.classList.remove('is-active');
        showingA = !showingA;
      };
      swapText(urlEl, stay.url);
      swapText(captionEl, stay.caption);
    }
    setInterval(next, INTERVAL);
  })();

  (function () {
    const el = document.getElementById('typewriterText');
    if (!el) return;
    const lines = [
      'Chosen by hand for its silence.',
      'No stock photos. No chain hotels.',
      'Every stay has a story worth living in.',
    ];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) { el.textContent = lines[0]; return; }
    let lineIndex = 0;
    let charIndex = 0;
    let deleting = false;
    const TYPE_SPEED = 45;
    const DELETE_SPEED = 28;
    const HOLD_TIME = 1900;
    function tick() {
      const current = lines[lineIndex];
      if (!deleting) {
        charIndex++;
        el.textContent = current.slice(0, charIndex);
        if (charIndex === current.length) {
          deleting = true;
          setTimeout(tick, HOLD_TIME);
          return;
        }
        setTimeout(tick, TYPE_SPEED);
      } else {
        charIndex--;
        el.textContent = current.slice(0, charIndex);
        if (charIndex === 0) {
          deleting = false;
          lineIndex = (lineIndex + 1) % lines.length;
          setTimeout(tick, 400);
          return;
        }
        setTimeout(tick, DELETE_SPEED);
      }
    }
    tick();
  })();

  (function () {
    const wrap = document.getElementById('activityTicker');
    const textEl = document.getElementById('activityText');
    if (!wrap || !textEl) return;
    const events = [
      'Someone in Pune just booked Pine Cabin',
      'A guest in Delhi is viewing Goa Treehouse',
      'Someone in Bangalore just booked The Glass House',
      'A guest in Mumbai is viewing Hillside Cottage',
      'Someone in Hyderabad just booked Sunset Villa',
      '3 people are viewing stays right now',
    ];
    let index = 0;
    const SHOW_TIME = 4500;
    const FADE_TIME = 400;
    function showNext() {
      textEl.textContent = events[index];
      wrap.classList.add('is-visible');
      setTimeout(() => {
        wrap.classList.remove('is-visible');
        setTimeout(() => {
          index = (index + 1) % events.length;
          showNext();
        }, FADE_TIME);
      }, SHOW_TIME);
    }

    setTimeout(showNext, 1200);
  })();

  (function () {
    const canvas = document.getElementById('globeCanvas');
    const wrap = document.getElementById('globeWrap');
    const section = document.getElementById('globeSection');
    if (!canvas || !wrap || !section) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    function resize() {
      const size = wrap.clientWidth;
      canvas.width = size;
      canvas.height = size;
    }
    resize();
    window.addEventListener('resize', resize);
    const cities = [
      { name: 'Goa',         lat: 15.29,  lon: 74.12  },
      { name: 'Coorg',       lat: 12.42,  lon: 75.74  },
      { name: 'Manali',      lat: 32.24,  lon: 77.19  },
      { name: 'Rishikesh',   lat: 30.09,  lon: 78.27  },
      { name: 'Bali',        lat: -8.34,  lon: 115.09 },
      { name: 'Iceland',     lat: 64.13,  lon: -21.82 },
      { name: 'Queenstown',  lat: -45.03, lon: 168.66 },
      { name: 'Banff',       lat: 51.18,  lon: -115.57 },
      { name: 'Patagonia',   lat: -51.73, lon: -72.5  },
      { name: 'Marrakech',   lat: 31.63,  lon: -7.99  },
    ];
    const connections = [
      [0,4],[0,5],[1,9],[2,7],[2,5],
      [3,6],[3,8],[4,6],[5,7],[8,9],[6,8],[9,0],
    ];
    let worldGeo = null;
    fetch('https://cdn.jsdelivr.net/npm/world-atlas@2/land-110m.json')
      .then((res) => res.json())
      .then((topo) => {
        const geometries = topo.objects.land.geometries;
        const arcs = topo.arcs;
        const transform = topo.transform;
        function decodeArc(arcIndex) {
          const arc = arcIndex < 0 ? arcs[~arcIndex].slice().reverse() : arcs[arcIndex];
          let x = 0, y = 0;
          const points = [];
          arc.forEach(([dx, dy]) => {
            x += dx; y += dy;
            const lon = x * transform.scale[0] + transform.translate[0];
            const lat = y * transform.scale[1] + transform.translate[1];
            points.push([lat, lon]);
          });
          return points;
        }
        const rings = [];
        geometries.forEach((geom) => {
          const polys = geom.type === 'Polygon' ? [geom.arcs] : geom.arcs;
          polys.forEach((poly) => {
            poly.forEach((ring) => {
              let points = [];
              ring.forEach((arcIndex) => {
                points = points.concat(decodeArc(arcIndex));
              });
              rings.push(points);
            });
          });
        });
        worldGeo = rings;
      })
      .catch(() => { worldGeo = null; });
    function latLonToVec3(lat, lon) {
      const la = (lat * Math.PI) / 180;
      const lo = (lon * Math.PI) / 180;
      return {
        x: Math.cos(la) * Math.cos(lo),
        y: Math.sin(la),
        z: Math.cos(la) * Math.sin(lo),
      };
    }
    function rotateY(v, theta) {
      const cos = Math.cos(theta), sin = Math.sin(theta);
      return {
        x: v.x * cos + v.z * sin,
        y: v.y,
        z: -v.x * sin + v.z * cos,
      };
    }
    function project(v, radius, cx, cy) {
      return { x: cx + v.x * radius, y: cy - v.y * radius, z: v.z };
    }
    function slerp(v0, v1, t) {
      const dot = Math.max(-1, Math.min(1, v0.x*v1.x + v0.y*v1.y + v0.z*v1.z));
      const omega = Math.acos(dot);
      if (omega < 1e-6) return v0;
      const s0 = Math.sin((1 - t) * omega) / Math.sin(omega);
      const s1 = Math.sin(t * omega) / Math.sin(omega);
      return {
        x: v0.x * s0 + v1.x * s1,
        y: v0.y * s0 + v1.y * s1,
        z: v0.z * s0 + v1.z * s1,
      };
    }
    const cityVecs = cities.map((c) => latLonToVec3(c.lat, c.lon));
    let rotation = 0;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function drawWireframe(theta, radius, cx, cy) {
    for (let lon = 0; lon < 360; lon += 30) {
      let prev = null;
      for (let lat = -90; lat <= 90; lat += 6) {
        const p = project(rotateY(latLonToVec3(lat, lon), theta), radius, cx, cy);
        const alpha = Math.max(0, p.z) * 0.35;
        if (alpha <= 0.01) { prev = null; continue; }
        if (prev) {
          ctx.beginPath();
          ctx.moveTo(prev.x, prev.y);
          ctx.lineTo(p.x, p.y);
          ctx.strokeStyle = `rgba(255,255,255,${alpha})`;
          ctx.lineWidth = 1;
          ctx.stroke();
        }
        prev = { x: p.x, y: p.y };
      }
    }
    for (let lat = -60; lat <= 60; lat += 30) {
      let prev = null;
      for (let lon = 0; lon <= 360; lon += 6) {
        const p = project(rotateY(latLonToVec3(lat, lon), theta), radius, cx, cy);
        const alpha = Math.max(0, p.z) * 0.35;
        if (alpha <= 0.01) { prev = null; continue; }
        if (prev) {
          ctx.beginPath();
          ctx.moveTo(prev.x, prev.y);
          ctx.lineTo(p.x, p.y);
          ctx.strokeStyle = `rgba(255,255,255,${alpha})`;
          ctx.lineWidth = 1;
          ctx.stroke();
        }
        prev = { x: p.x, y: p.y };
      }
    }
    ctx.beginPath();
    ctx.arc(cx, cy, radius, 0, Math.PI * 2);
    ctx.strokeStyle = 'rgba(255,255,255,.28)';
    ctx.stroke();
  }
  function drawLand(theta, radius, cx, cy) {
    if (!worldGeo) return;
    worldGeo.forEach((ring) => {
      let prev = null;
      for (let i = 0; i < ring.length; i++) {
        const [lat, lon] = ring[i];
        const p = project(rotateY(latLonToVec3(lat, lon), theta), radius, cx, cy);
        const alpha = Math.max(0, p.z) * 0.85;
        if (alpha <= 0.02) { prev = null; continue; }
        if (prev) {
          ctx.beginPath();
          ctx.moveTo(prev.x, prev.y);
          ctx.lineTo(p.x, p.y);
          ctx.strokeStyle = `rgba(255,255,255,${alpha})`;
          ctx.lineWidth = 1;
          ctx.stroke();
        }
        prev = { x: p.x, y: p.y };
      }
    });
  }
    function drawConnections(theta, radius, cx, cy) {
      connections.forEach(([a, b]) => {
        const v0 = cityVecs[a], v1 = cityVecs[b];
        const steps = 48;
        for (let i = 0; i < steps; i++) {
          if (i % 2 === 0) continue;
          const t0 = i / steps, t1 = (i + 1) / steps;
          const p0 = project(rotateY(slerp(v0, v1, t0), theta), radius, cx, cy);
          const p1 = project(rotateY(slerp(v0, v1, t1), theta), radius, cx, cy);
          const zAvg = (p0.z + p1.z) / 2;
          if (zAvg <= -0.05) continue;
          const alpha = Math.min(1, Math.max(0, zAvg + 0.15)) * 0.85;
          ctx.strokeStyle = `rgba(255,106,26,${alpha})`;
          ctx.lineWidth = 1.4;
          ctx.beginPath();
          ctx.moveTo(p0.x, p0.y);
          ctx.lineTo(p1.x, p1.y);
          ctx.stroke();
        }
      });
    }
    function drawCities(theta, radius, cx, cy) {
      cityVecs.forEach((v, i) => {
        const p = project(rotateY(v, theta), radius, cx, cy);
        if (p.z <= -0.05) return;
        const alpha = Math.min(1, Math.max(0, p.z + 0.2));
        ctx.beginPath();
        ctx.arc(p.x, p.y, 3, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(255,106,26,${alpha})`;
        ctx.shadowColor = 'rgba(255,106,26,.8)';
        ctx.shadowBlur = 6;
        ctx.fill();
        ctx.shadowBlur = 0;
        if (alpha > 0.55) {
          ctx.font = '10px "JetBrains Mono", monospace';
          ctx.fillStyle = `rgba(237,237,237,${alpha})`;
          ctx.fillText(cities[i].name, p.x + 7, p.y - 6);
        }
      });
    }
    function render(t) {
      const size = canvas.width;
      const cx = size / 2, cy = size / 2;
      const radius = size * 0.42;
      ctx.clearRect(0, 0, size, size);
      drawWireframe(rotation, radius, cx, cy);
      drawLand(rotation, radius, cx, cy);
      drawConnections(rotation, radius, cx, cy);
      drawCities(rotation, radius, cx, cy);
      if (!reduced) rotation += 0.0022;
      requestAnimationFrame(render);
    }
    requestAnimationFrame(render);

    function updateVisibility() {
      const rect = section.getBoundingClientRect();
      const viewportCenter = window.innerHeight / 2;
      const sectionCenter = rect.top + rect.height / 2;
      const dist = Math.abs(sectionCenter - viewportCenter);
      const maxDist = window.innerHeight / 2 + rect.height / 2;
      const proximity = 1 - Math.min(1, dist / maxDist);
      wrap.style.opacity = (0.15 + proximity * 0.85).toFixed(3);
      wrap.style.filter = `brightness(${(0.6 + proximity * 0.7).toFixed(3)})`;
    }
    let ticking = false;
    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(() => { updateVisibility(); ticking = false; });
        ticking = true;
      }
    });
    window.addEventListener('resize', updateVisibility);
    updateVisibility();
  })();
  (function () {
    const section = document.getElementById('whySection');
    if (!section) return;
    const floats = section.querySelectorAll('.why-float');
    const zones = section.querySelectorAll('.why-zone');
    function setActive(target) {
      zones.forEach(z => z.classList.toggle('is-active', z.dataset.zone === target));
      floats.forEach(f => f.classList.toggle('is-active', f.dataset.target === target));
    }
    let hovering = false;
    floats.forEach(f => {
      f.addEventListener('mouseenter', () => { hovering = true; setActive(f.dataset.target); });
      f.addEventListener('mouseleave', () => { hovering = false; setActive(null); });
    });
    const order = ['photo', 'location', 'host'];
    let idx = 0;
    setInterval(() => {
      if (hovering) return;
      setActive(order[idx]);
      idx = (idx + 1) % order.length;
    }, 3800); 
  })();
  (function () {
    const modal = document.getElementById('reviewModal');
    const closeBtn = document.getElementById('reviewModalClose');
    if (!modal) return;
    const avatarEl = document.getElementById('reviewModalAvatar');
    const nameEl = document.getElementById('reviewModalName');
    const fullEl = document.getElementById('reviewModalFull');
    const roleEl = document.getElementById('reviewModalRole');
    const companyEl = document.getElementById('reviewModalCompany');
    document.querySelectorAll('.testimonial-card').forEach(card => {
      card.style.cursor = 'pointer';
      card.addEventListener('click', () => {
        const img = card.querySelector('.testimonial-user img');
        avatarEl.src = img ? img.src : '';
        nameEl.textContent = card.dataset.name || '';
        fullEl.textContent = card.dataset.full || card.querySelector('.testimonial-quote')?.textContent || '';
        roleEl.textContent = card.dataset.role || '';
        companyEl.textContent = (card.dataset.company || '') + (card.dataset.location ? ' · ' + card.dataset.location : '');
        modal.classList.add('is-open');
        document.body.style.overflow = 'hidden';
      });
    });
    function closeModal() {
      modal.classList.remove('is-open');
      document.body.style.overflow = '';
    }
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    window.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
  })();

  (function () {
    const catButtons = document.querySelectorAll('.faq-cat-btn');
    const groups = document.querySelectorAll('.faq-group');
    if (!catButtons.length || !groups.length) return;

    catButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.category;
        catButtons.forEach(b => b.classList.toggle('is-active', b === btn));
        groups.forEach(g => g.classList.toggle('is-visible', g.dataset.category === target));
      });
    });

    groups.forEach(group => {
      const items = group.querySelectorAll('.faq-item');
      items.forEach(item => {
        const q = item.querySelector('.faq-q');
        q.addEventListener('click', () => {
          const wasOpen = item.classList.contains('is-open');
          items.forEach(i => i.classList.remove('is-open'));
          if (!wasOpen) item.classList.add('is-open');
        });
      });
    });
  })();
</script>
</html>