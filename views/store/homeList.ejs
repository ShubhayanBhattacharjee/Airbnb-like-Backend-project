<%- include('../partials/header', { pageTitle: "Explore Homes" }) %>
<link rel="stylesheet" href="/css/store/homeList.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
</head>
<body class="explore-body">
  <%- include('../partials/navbar') %>
  <main class="explore-page">

    <section class="explore-hero">
      <div class="hero-glow"></div>
      <div class="hero-inner">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="hero-mini">
              <span class="hero-mini-line"></span>
              ELEVATE STAYS
            </p>
            <h1 class="hero-heading">Handpicked homes.<span>Timeless stays.</span></h1>
            <p class="hero-description">
              Curated homes in the world's most beautiful places.
              Each stay chosen for its soul, silence, and story.
            </p>

            <form action="/homeList" method="GET" class="boarding-pass">
              <div class="pass-top">
                <span class="pass-tag">BOARDING PASS</span>
                <span class="pass-tag pass-tag-route">HOME <i class="ri-arrow-right-line"></i> ANYWHERE</span>
              </div>
              <div class="pass-field pass-field-wide">
                <span class="pass-label">Destination / Property</span>
                <input
                  type="text"
                  name="search"
                  placeholder="Search by name or location..."
                  value="<%= filters.search %>"
                >
              </div>
              <div class="pass-notch pass-notch-left"></div>
              <div class="pass-notch pass-notch-right"></div>
              <div class="pass-perforation"></div>
              <div class="pass-row">
                <div class="pass-field">
                  <span class="pass-label">Check-in</span>
                  <input
                    type="date"
                    name="checkIn"
                    value="<%= filters.checkIn %>"
                    min="<%= new Date().toISOString().slice(0, 10) %>"
                  >
                </div>
                <i class="ri-flight-takeoff-line pass-icon"></i>
                <div class="pass-field">
                  <span class="pass-label">Check-out</span>
                  <input
                    type="date"
                    name="checkOut"
                    value="<%= filters.checkOut %>"
                    min="<%= new Date().toISOString().slice(0, 10) %>"
                  >
                </div>
              </div>
              <div class="pass-barcode"></div>
              <button type="submit" class="pass-submit">
                Search Homes
              </button>
            </form>
          </div>

          <div class="hero-board">
            <div class="board-header">
              <span class="board-header-title"><i class="ri-hotel-line"></i> Live stays</span>
              <span class="board-live"><span class="board-live-dot"></span> Updating</span>
            </div>
            <div class="board-cols">
              <span>Destination</span>
              <span>Type</span>
              <span>Rate</span>
              <span>Status</span>
            </div>
            <% boardHomes.forEach((home, i) => { %>
              <div class="board-row" style="animation-delay:<%= (i * 0.3 + 0.1).toFixed(1) %>s">
                <span class="board-city"><%= home.city %></span>
                <span class="board-detail"><%= home.no_of_bedRooms %> bed stay</span>
                <span class="board-price">₹<%= home.price.toLocaleString('en-IN') %></span>
                <span class="board-status">Open</span>
              </div>
            <% }) %>
            <div class="board-footer">
              <i class="ri-refresh-line"></i> Availability refreshes as guests book
            </div>
          </div>

        </div>
      </div>
    </section>

    <section class="explore-layout">

      <aside class="explore-sidebar">
        <form action="/homeList" method="GET" id="filterForm">
          <div class="sidebar-header">
            <h3>Filters</h3>
            <a href="/homeList"
              class="sidebar-clear-link"
              onclick="sessionStorage.removeItem('homeListFilters')">
              Clear all
            </a>
          </div>
          <input type="hidden" name="search" value="<%= filters.search %>">
          <input type="hidden" name="checkIn"  value="<%= filters.checkIn %>">
          <input type="hidden" name="checkOut" value="<%= filters.checkOut %>">

          <div class="filter-group">
            <h4>Location</h4>
            <div class="select-wrap">
              <i class="ri-map-pin-2-line select-icon"></i>
              <select name="location" onchange="document.getElementById('filterForm').submit()">
                <option value="">All Regions</option>
                <% locations.forEach(loc => { %>
                  <option value="<%= loc %>" <%= filters.location === loc ? 'selected' : '' %>>
                    <%= loc %>
                  </option>
                <% }) %>
              </select>
            </div>
          </div>

          <div class="filter-group">
            <h4>Price Range (per night)</h4>
            <div class="price-inputs">
              <div class="price-input-wrap">
                <span class="price-icon">₹</span>
                <input type="number" name="minPrice" id="minPrice" placeholder="Min" value="<%= filters.minPrice %>" class="price-input">
                <div class="spin-btns">
                  <div class="spin-btn spin-up" onclick="stepPrice('minPrice', 1)"></div>
                  <div class="spin-btn spin-down" onclick="stepPrice('minPrice', -1)"></div>
                </div>
              </div>
              <div class="price-input-wrap">
                <span class="price-icon">₹</span>
                <input type="number" name="maxPrice" id="maxPrice" placeholder="Max" value="<%= filters.maxPrice %>" class="price-input">
                <div class="spin-btns">
                  <div class="spin-btn spin-up" onclick="stepPrice('maxPrice', 1)"></div>
                  <div class="spin-btn spin-down" onclick="stepPrice('maxPrice', -1)"></div>
                </div>
              </div>
            </div>
            <div class="range-values">
              <span>Min: ₹<%= minPriceBound %></span>
              <span>Max: ₹<%= maxPriceBound %></span>
            </div>
          </div>

          <div class="filter-group">
            <h4>Bedrooms</h4>
            <div class="bedroom-pills">
              <label class="bedroom-pill">
                <input type="radio" name="bedrooms" value="any" <%= filters.bedrooms === 'any' ? 'checked' : '' %> onchange="document.getElementById('filterForm').submit()">
                <span>Any</span>
              </label>
              <label class="bedroom-pill">
                <input type="radio" name="bedrooms" value="1" <%= filters.bedrooms === '1' ? 'checked' : '' %> onchange="document.getElementById('filterForm').submit()">
                <span>1</span>
              </label>
              <label class="bedroom-pill">
                <input type="radio" name="bedrooms" value="2" <%= filters.bedrooms === '2' ? 'checked' : '' %> onchange="document.getElementById('filterForm').submit()">
                <span>2</span>
              </label>
              <label class="bedroom-pill">
                <input type="radio" name="bedrooms" value="3" <%= filters.bedrooms === '3' ? 'checked' : '' %> onchange="document.getElementById('filterForm').submit()">
                <span>3</span>
              </label>
              <label class="bedroom-pill">
                <input type="radio" name="bedrooms" value="4" <%= filters.bedrooms === '4' ? 'checked' : '' %> onchange="document.getElementById('filterForm').submit()">
                <span>4</span>
              </label>
              <label class="bedroom-pill">
                <input type="radio" name="bedrooms" value="5+" <%= filters.bedrooms === '5+' ? 'checked' : '' %> onchange="document.getElementById('filterForm').submit()">
                <span>5+</span>
              </label>
            </div>
          </div>

          <button type="submit" class="apply-filters-btn">
            Apply Filters
          </button>
        </form>
      </aside>

      <section class="homes-section">
        <div class="homes-topbar">
          <p>
            <strong><%= total %></strong> home<%= total !== 1 ? 's' : '' %> found
            <% if (filters.search || filters.location || filters.minPrice || filters.maxPrice || filters.bedrooms !== 'any') { %>
              <a href="/homeList"
                class="clear-filters-link"
                onclick="sessionStorage.removeItem('homeListFilters')">
                (clear filters)
              </a>
            <% } %>
          </p>
          <% if (filters.checkIn && filters.checkOut) { %>
            <p class="date-range-note">
              <i class="ri-calendar-line"></i>
              <%= new Date(filters.checkIn).toLocaleDateString('en-IN', {day:'numeric',month:'short'}) %>
              →
              <%= new Date(filters.checkOut).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %>
              <a href="/homeList" class="remove-date-link">✕</a>
            </p>
          <% } %>
          <div class="sort-box">
            <span>Sort by</span>
            <select id="sortSelect" onchange="applySort(this.value)">
              <option value="newest"     <%= filters.sort === 'newest'     ? 'selected' : '' %>>Newest</option>
              <option value="price_asc"  <%= filters.sort === 'price_asc'  ? 'selected' : '' %>>Price Low to High</option>
              <option value="price_desc" <%= filters.sort === 'price_desc' ? 'selected' : '' %>>Price High to Low</option>
            </select>
          </div>
        </div>
        <div id="listMap" class="list-map"></div>
        <% if (registeredHomes.length === 0) { %>
          <div class="explore-empty">
            <i class="ri-home-3-line"></i>
            <h3>No homes found</h3>
            <p>Try adjusting your filters or search terms.</p>
            <a href="/homeList">
              Clear all filters
            </a>
          </div>
        <% } else { %>
          <div class="homes-grid">
            <% registeredHomes.forEach(home => { %>
              <div class="home-card">
                <div class="home-image-wrapper">
                  <img src="<%= home.photos[0] %>" alt="<%= home.houseName %>">
                  <form action="/favourites" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="homeId" value="<%= home._id %>">
                    <input type="hidden" name="redirectTo" value="/homeList">
                    <button type="submit" class="wishlist-btn <%= favouriteIds.includes(home._id.toString()) ? 'is-active' : '' %>">
                      <% if(favouriteIds.includes(home._id.toString())) { %>
                        <i class="ri-heart-fill"></i>
                      <% } else { %>
                        <i class="ri-heart-3-line"></i>
                      <% } %>
                    </button>
                  </form>
                </div>
                <div class="home-content">
                  <div class="home-heading">
                    <div>
                      <h3><%= home.houseName %></h3>
                      <p class="home-location">
                        <i class="ri-map-pin-line"></i>
                        <% if (home.city && home.state) { %>
                          <%= home.city %>, <%= home.state %>
                        <% } else { %>
                          <%= home.location %>
                        <% } %>
                      </p>
                    </div>
                    <div class="rating">
                      <i class="ri-star-fill"></i>
                      <span><%= home.reviewCount > 0 ? home.avgRating : 'New' %></span>
                    </div>
                  </div>
                  <p class="home-bedrooms">
                    <i class="ri-hotel-bed-line"></i> <%= home.no_of_bedRooms %> bedroom<%= home.no_of_bedRooms > 1 ? 's' : '' %>
                  </p>
                  <div class="home-footer">
                    <p class="home-price">
                      ₹<%= home.price %> <span>/ night</span>
                    </p>
                    <a href="/homeList/<%= home._id %>" class="details-btn">Book now</a>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
        <% if (totalPages > 1) { %>
          <div class="pagination-wrap">
            <% if (page > 1) { %>
              <a href="/homeList?<%= new URLSearchParams({...filters, page: page - 1}).toString() %>" class="page-link">
                ← Prev
              </a>
            <% } %>
            <% for (let i = 1; i <= totalPages; i++) { %>
              <a href="/homeList?<%= new URLSearchParams({...filters, page: i}).toString() %>"
                class="page-link <%= i === page ? 'active' : '' %>">
                <%= i %>
              </a>
            <% } %>
            <% if (page < totalPages) { %>
              <a href="/homeList?<%= new URLSearchParams({...filters, page: page + 1}).toString() %>" class="page-link">
                Next →
              </a>
            <% } %>
          </div>
          <p class="page-info">
            Page <%= page %> of <%= totalPages %>
          </p>
        <% } %>
      </section>
    </section>
  </main>
  <% if (registeredHomes.length > 0) { %>
<script type="application/json" id="map-homes-data"><%- JSON.stringify(
    registeredHomes
        .filter(h => h.lat && h.lng)
        .map(h => ({ lat: h.lat, lng: h.lng, name: h.houseName, price: h.price, url: '/homeList/' + h._id }))
) %></script>
<% } %>

<script>
  (function () {
    const el = document.getElementById('liveCount');
    if (!el) return;
    let count = 23;
    setInterval(() => {
      const delta = Math.floor(Math.random() * 3) - 1;
      count = Math.min(34, Math.max(18, count + delta));
      el.textContent = count;
    }, 4000);
  })();
  function applySort(sortValue) {
    const params = new URLSearchParams(window.location.search);
    params.set('sort', sortValue);
    window.location.href = '/homeList?' + params.toString();
  }
  const checkInInput  = document.querySelector('input[name="checkIn"]');
  const checkOutInput = document.querySelector('input[name="checkOut"]');
  if (checkInInput && checkOutInput) {
      checkInInput.addEventListener('change', () => {
          const nextDay = new Date(checkInInput.value);
          nextDay.setDate(nextDay.getDate() + 1);
          checkOutInput.min = nextDay.toISOString().slice(0, 10);
          if (checkOutInput.value && checkOutInput.value <= checkInInput.value) {
              checkOutInput.value = '';
          }
      });
  }
  (function() {
      const params = new URLSearchParams(window.location.search);
      if (params.toString()) {
          sessionStorage.setItem('homeListFilters', params.toString());
      }
  })();
  (function() {
      const params = new URLSearchParams(window.location.search);
      const saved  = sessionStorage.getItem('homeListFilters');
      if (!params.toString() && saved) {
          const referrer = document.referrer;
          if (referrer && referrer.includes('/homeList/')) {
              window.location.replace('/homeList?' + saved);
          }
      }
  })();
  
  function stepPrice(id, dir) {
    const input = document.getElementById(id);
    const step = 100;
    let val = parseInt(input.value) || 0;
    val += dir * step;
    if (val < 0) val = 0;
    input.value = val;
  }
</script>
<%- include('../partials/footer') %>
</body>

</html>S