<%- include('../partials/header', { pageTitle: "Booking Confirmed" }) %>
<link rel="stylesheet" href="/css/store/bookingConfirmation.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/4.2.0/remixicon.min.css">
</head>
<body class="confirmation-body">
<%- include('../partials/navbar') %>

<section class="confirmation-hero">
  <span class="confirmation-badge">
    <span class="dot"></span>
    BOOKING CONFIRMED
  </span>
  <h1>You're all <span id="confirmation-badge-highlight">set.</span></h1>
  <p class="confirmation-subtext">Your stay has been reserved &mdash; see you there.</p>
  <p class="confirmation-redirect-note mono">
    Taking you to <a href="/bookings">My Bookings</a> in <span id="redirectCounter">30</span>s
  </p>
</section>
<main class="confirmation-page">
  <div class="confirmation-ticket">
    <div class="ticket-photo-wrapper">
      <img src="<%= booking.home.photos[0] %>" alt="" class="ticket-photo">
      <div class="ticket-photo-overlay"></div>
    </div>

    <div class="ticket-body">
      <div class="ticket-title-row">
        <h2><%= booking.home.houseName %></h2>
        <p class="confirmation-location"><i class="ri-map-pin-line"></i> <span><%= booking.home.location %></span></p>
      </div>

      <div class="ticket-details">
        <div>
          <p>Check-in</p>
          <p><%= new Date(booking.checkIn).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></p>
        </div>
        <div>
          <p>Check-out</p>
          <p><%= new Date(booking.checkOut).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric'}) %></p>
        </div>
        <div>
          <p>Guests</p>
          <p><%= booking.guests %> guest<%= booking.guests > 1 ? 's' : '' %></p>
        </div>
        <div>
          <p>Duration</p>
          <p><%= booking.nights %> night<%= booking.nights > 1 ? 's' : '' %></p>
        </div>
      </div>
    </div>

    <div class="ticket-divider">
      <span class="ticket-notch notch-left"></span>
      <span class="ticket-notch notch-right"></span>
    </div>

    <div class="ticket-stub">
      <div class="ticket-stub-row">
        <div>
          <span class="ticket-stub-label mono">Total Paid</span>
          <span class="ticket-stub-amount mono">&#8377;<%= booking.totalPrice %></span>
        </div>
        <span class="ticket-stub-badge mono">Confirmed</span>
      </div>
      <div class="ticket-barcode"></div>
      <p class="confirmation-booking-id">Booking ID: <%= booking.bookingId %></p>
      <p class="confirmation-payment-id">Payment ID: <%= booking.razorpayPaymentId %></p>
    </div> 
  </div>
  <div class="confirmation-actions">
      <a href="/bookings" class="confirmation-btn confirmation-btn-primary">
        <i class="ri-file-list-3-line"></i> View My Bookings
      </a>
      <a href="/homeList" class="confirmation-btn confirmation-btn-secondary">
        <i class="ri-compass-3-line"></i> Explore More
      </a>
    </div>
    
</main>
<script>
  (function () {
    let secondsLeft = 30;
    const counterEl = document.getElementById('redirectCounter');
    const interval = setInterval(() => {
      secondsLeft--;
      if (counterEl) counterEl.textContent = secondsLeft;
      if (secondsLeft <= 0) {
        clearInterval(interval);
        window.location.href = '/bookings';
      }
    }, 1000);

    document.querySelectorAll('.confirmation-actions a').forEach(a =>
      a.addEventListener('click', () => clearInterval(interval))
    );
  })();
</script>
<%- include('../partials/footer') %>
</body>
</html>