<%- include("partials/header", { pageTitle: "Hosts" }) %>
<link rel="stylesheet" href="/css/general/hosts.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css">
</head>
  <body class="hosts-body">
    <%- include("partials/navbar") %>

    <div class="hero">
      <section class="hosts-hero">
        <div class="hero-top">
          <p class="hero-eyebrow">Field Notes <span class="hero-eyebrow-dot">·</span> 2026 Edition</p>
          <div class="hero-meta mono">
            <span><%= heroStats.totalHosts %> hosts</span>
            <span class="meta-dot">/</span>
            <span><%= heroStats.totalCountries %> countries</span>
            <span class="meta-dot">/</span>
            <span><%= heroStats.guestRating %> guest rating</span>
          </div>
        </div>
        <h1 class="hero-heading">
          A living index of the<br>
          <span id="hero-heading-highlighted">people who open their doors.</span>
        </h1>
        <div class="hero-lower">
          <p class="hero-sub">
            Every host on file has been vetted, visited, and vouched for —
            hospitality mapped one doorway at a time, across the hidden
            corners of the map.
          </p>
          <a href="#ledger" class="hero-cta">
            Browse the ledger 
          </a>
        </div>
      </section>
    </div>

    <div class="hero-marquee" aria-hidden="true">
      <div class="marquee-track">
        <div class="marquee-group">
          <% const marqueeHosts = hosts.slice(0,14); %>
          <% marqueeHosts.forEach(host => { %>
            <div class="marquee-item">
              <div class="marquee-avatar">
                <% if (host.profileImage && host.profileImage.trim() !== "") { %>
                  <img src="<%= host.profileImage %>" alt="<%= host.fname %>">
                <% } else { %>
                  <div class="marquee-initials">
                    <%= host.fname[0] %><%= host.lname[0] %>
                  </div>
                <% } %>
              </div>
              <span><%= host.fname %> — <%= host.location %></span>
            </div>
          <% }) %>
        </div>
        <div class="marquee-group">
          <% marqueeHosts.forEach(host => { %>
            <div class="marquee-item">
              <div class="marquee-avatar">
                <% if (host.profileImage && host.profileImage.trim() !== "") { %>
                  <img src="<%= host.profileImage %>" alt="<%= host.fname %>">
                <% } else { %>
                  <div class="marquee-initials">
                    <%= host.fname[0] %><%= host.lname[0] %>
                  </div>
                <% } %>
              </div>
              <span><%= host.fname %> — <%= host.location %></span>
            </div>
          <% }) %>
        </div>
      </div>
    </div>

    <section class="ledger-section" id="ledger">
      <div class="ledger-bar">
        <div class="ledger-heading">
          <h2>The Ledger</h2>
          <p class="mono"><%= hosts.length %> entries on file</p>
        </div>
        <div class="ledger-controls">
          <div class="search-box">
            <i class="ri-search-line"></i>
            <input
              type="text"
              id="hostSearch"
              placeholder="Search by name or place…">
          </div>
          <select id="countryFilter">
            <option value="">All locations</option>
            <% countries.forEach(country => { %>
              <option value="<%= country %>"><%= country %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="ledger-list-head mono">
        <span class="col-index">No.</span>
        <span class="col-photo"></span>
        <span class="col-info">Host</span>
        <span class="col-stats">On record</span>
        <span class="col-homes">Listings</span>
      </div>

      <div class="ledger-list">
        <% hosts.forEach((host, idx) => { %>
          <div class="ledger-row"
            data-name="<%= (host.fname + ' ' + host.lname).toLowerCase() %>"
            data-country="<%= (host.country || '').toLowerCase() %>"
            data-host='<%- JSON.stringify({
                  _id: host._id,
                  fname: host.fname,
                  lname: host.lname,
                  profileImage: host.profileImage,
                  bio: host.bio,
                  location: host.location,
                  country: host.country,
                  hostId: host.hostId || '',
                  email: host.email || '',
                  phone: host.phone || '',
                  memberSince: host.memberSince || host.createdAt || '',
                  responseRate: host.responseRate || '',
                  responseTime: host.responseTime || '',
                  languages: host.languages || [],
                  verified: !!host.verified,
                  totalListings: host.totalListings,
                  totalBookings: host.totalBookings,
                  homes: host.homes.map(home => ({
                      _id: home._id,
                      houseName: home.houseName,
                      price: home.price,
                      photo: home.photos[0] || ""
                  }))
              }) %>'>

            <span class="row-index mono"><%= String(idx + 1).padStart(2, '0') %></span>

            <div class="row-thumb">
              <% if (host.profileImage && host.profileImage.trim() !== "") { %>
                <img src="<%= host.profileImage %>" alt="<%= host.fname %>"
                    onerror="this.replaceWith(Object.assign(document.createElement('div'), {className:'row-thumb-initials', textContent:'<%= host.fname[0] %><%= host.lname[0] %>'}))">
              <% } else { %>
                <div class="row-thumb-initials"><%= host.fname[0] %><%= host.lname[0] %></div>
              <% } %>
              <span class="row-thumb-hint">View</span>
            </div>

            <div class="row-info">
              <div class="row-name-line">
                <h3><%= host.fname %> <%= host.lname %></h3>
                <% if (host.hostId) { %>
                  <span class="row-id-chip mono"><%= host.hostId %></span>
                <% } %>
              </div>
              <p class="row-bio"><%= host.bio || 'No bio yet' %></p>
              <span class="row-location mono"><%= host.location %>, <%= host.country %></span>
            </div>

            <div class="row-stats mono">
              <div><b><%= host.totalListings %></b><span>listings</span></div>
              <div><b><%= host.totalBookings %></b><span>stays</span></div>
            </div>

            <div class="row-homes">
              <% host.homes.slice(0, 3).forEach(home => { %>
                <a href="/homeList/<%= home._id %>" title="<%= home.houseName %>">
                  <% if (home.photos[0] && home.photos[0].trim() !== "") { %>
                    <img src="<%= home.photos[0] %>" alt="<%= home.houseName %>"
                        onerror="this.replaceWith(Object.assign(document.createElement('div'), {className:'home-thumb-placeholder', textContent:'<%= home.houseName[0] %>'}))">
                  <% } else { %>
                    <div class="home-thumb-placeholder"><%= home.houseName[0] %></div>
                  <% } %>
                </a>
              <% }) %>
              <% if (host.homes.length > 3) { %>
                <span class="homes-more mono">+<%= host.homes.length - 3 %></span>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="no-results" id="noResults">
        <div class="no-results-content">
          <h3>No entries found</h3>
          <p>Try searching with a different name or location.</p>
        </div>
      </div>

      <div class="load-more-wrapper">
        <button class="load-more-btn">
          Load next entries
          <i class="ri-arrow-down-s-line"></i>
        </button>
      </div>
    </section>

    <div class="host-sidebar-overlay" id="hostSidebarOverlay"></div>
    <aside class="host-sidebar" id="hostSidebar">
      <button class="host-sidebar-close" id="hostSidebarClose" aria-label="Close">
        <i class="ri-close-line"></i>
      </button>
      <div class="host-sidebar-content" id="hostSidebarContent">
      </div>
    </aside>

    <script>
      const searchInput = document.getElementById("hostSearch");
      const countryFilter = document.getElementById("countryFilter");
      const hostRows = document.querySelectorAll(".ledger-row");
      const loadMoreBtn = document.querySelector(".load-more-btn");
      let visibleCount = 8;
      hostRows.forEach((row, index) => {
          if (index >= visibleCount) {
              row.style.display = "none";
          }
      });
      loadMoreBtn.addEventListener("click", () => {
          visibleCount += 8;
          hostRows.forEach((row, index) => {
              if (index < visibleCount) {
                  row.style.display = "grid";
              }
          });
          if (visibleCount >= hostRows.length) {
              loadMoreBtn.style.display = "none";
          }
      });
      const noResults = document.getElementById("noResults");
      function filterHosts() {
        const searchValue = searchInput.value.toLowerCase().trim();
        const selectedCountry = countryFilter.value.toLowerCase();
        let visibleRows = 0;
        hostRows.forEach(row => {
          const hostName = row.dataset.name;
          const hostCountry = row.dataset.country;
          const matchesSearch = hostName.includes(searchValue);
          const matchesCountry = selectedCountry === "" || hostCountry === selectedCountry;
          if (matchesSearch && matchesCountry) {
            row.style.display = "grid";
            visibleRows++;
          } else {
            row.style.display = "none";
          }
        });
        noResults.style.display = visibleRows === 0 ? "flex" : "none";
      }

      searchInput.addEventListener("input", filterHosts);
      countryFilter.addEventListener("change", filterHosts);

      const sidebar = document.getElementById("hostSidebar");
      const sidebarOverlay = document.getElementById("hostSidebarOverlay");
      const sidebarContent = document.getElementById("hostSidebarContent");
      const sidebarClose = document.getElementById("hostSidebarClose");
      function openHostSidebar(host) {
        const initials = (host.fname[0] || "") + (host.lname[0] || "");
        const imageBlock = (host.profileImage && host.profileImage.trim() !== "")
          ? `<img class="host-sidebar-avatar-img" src="${host.profileImage}" alt="${host.fname}"
              onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'host-sidebar-avatar-initials',textContent:'${initials}'}))">`
          : `<div class="host-sidebar-avatar-initials">${initials}</div>`;
        const homesBlock = host.homes.map(home => {
          const safeInitial = (home.houseName || "?")[0];
          const thumb = (home.photo && home.photo.trim() !== "")
            ? `<img src="${home.photo}" alt="${home.houseName}"
                onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'home-thumb-placeholder',textContent:'${safeInitial}'}))">`
            : `<div class="home-thumb-placeholder">${safeInitial}</div>`;
          return `
            <a class="host-sidebar-home" href="/homeList/${home._id}">
              ${thumb}
              <div>
                <p class="home-name">${home.houseName}</p>
                <p class="home-price mono">$${home.price}/night</p>
              </div>
            </a>`;
        }).join("");
        const hostIdBlock = host.hostId
          ? `<span class="row-id-chip mono">${host.hostId}</span>`
          : "";
        const verifiedBadge = host.verified
          ? `<span class="host-sidebar-verified"><i class="ri-shield-check-fill"></i>Verified</span>`
          : "";

        const contactItems = [];
        if (host.phone) {
          contactItems.push(`
            <a class="host-sidebar-contact-item" href="tel:${host.phone}">
              <i class="ri-phone-fill"></i>
              <div>
                <span class="contact-label">Phone</span>
                <span class="contact-value mono">${host.phone}</span>
              </div>
            </a>`);
        }
        if (host.email) {
          contactItems.push(`
            <a class="host-sidebar-contact-item" href="mailto:${host.email}">
              <i class="ri-mail-fill"></i>
              <div>
                <span class="contact-label">Email</span>
                <span class="contact-value mono">${host.email}</span>
              </div>
            </a>`);
        }
        const contactBlock = contactItems.length
          ? `<div class="host-sidebar-contact">${contactItems.join("")}</div>`
          : "";

        let memberSinceLabel = "";
        if (host.memberSince) {
          const parsed = new Date(host.memberSince);
          memberSinceLabel = isNaN(parsed) ? String(host.memberSince) : parsed.toLocaleDateString(undefined, { month: "short", year: "numeric" });
        }
        const factItems = [];
        if (memberSinceLabel) {
          factItems.push(`<div class="fact-item"><i class="ri-calendar-2-line"></i><div><span class="contact-label">Hosting since</span><span class="contact-value">${memberSinceLabel}</span></div></div>`);
        }
        if (host.responseRate) {
          factItems.push(`<div class="fact-item"><i class="ri-reply-line"></i><div><span class="contact-label">Response rate</span><span class="contact-value">${host.responseRate}</span></div></div>`);
        }
        if (host.responseTime) {
          factItems.push(`<div class="fact-item"><i class="ri-time-line"></i><div><span class="contact-label">Responds in</span><span class="contact-value">${host.responseTime}</span></div></div>`);
        }
        if (host.languages && host.languages.length) {
          factItems.push(`<div class="fact-item"><i class="ri-translate-2"></i><div><span class="contact-label">Speaks</span><span class="contact-value">${host.languages.join(", ")}</span></div></div>`);
        }
        const factsBlock = factItems.length
          ? `<div class="host-sidebar-facts">${factItems.join("")}</div>`
          : "";

        sidebarContent.innerHTML = `
          <div class="host-sidebar-avatar">${imageBlock}</div>
          <div class="host-sidebar-name-row">
            <h2>${host.fname} ${host.lname}</h2>
            ${hostIdBlock}
            ${verifiedBadge}
          </div>
          <p class="host-sidebar-location">${host.location || ""}${host.location && host.country ? ", " : ""}${host.country || ""}</p>
          <p class="host-sidebar-bio">${host.bio}</p>
          ${contactBlock}
          ${factsBlock}
          <div class="host-sidebar-stats">
            <div><b class="mono">${host.totalListings}</b><span>Listings</span></div>
            <div><b class="mono">${host.totalBookings}</b><span>Stays hosted</span></div>
          </div>
          <h3 class="host-sidebar-subheading">All Listings</h3>
          <div class="host-sidebar-homes">
            ${homesBlock || '<p class="host-sidebar-empty">No listings yet.</p>'}
          </div>
        `;
        sidebar.classList.add("open");
        sidebarOverlay.classList.add("open");
        document.body.style.overflow = "hidden";
      }
      function closeHostSidebar() {
        sidebar.classList.remove("open");
        sidebarOverlay.classList.remove("open");
        document.body.style.overflow = "";
      }
      document.querySelectorAll(".ledger-row").forEach(row => {
        row.style.cursor = "pointer";
        row.addEventListener("click", (e) => {
          if (e.target.closest(".row-homes")) return; // let listing links navigate normally
          const host = JSON.parse(row.dataset.host);
          openHostSidebar(host);
        });
      });
      sidebarClose.addEventListener("click", closeHostSidebar);
      sidebarOverlay.addEventListener("click", closeHostSidebar);
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeHostSidebar();
      });

      (function () {
        const params = new URLSearchParams(window.location.search);
        const targetId = params.get('host');
        if (!targetId) return;

        const rows = document.querySelectorAll('.ledger-row');

        for (const row of rows) {
          try {
            const host = JSON.parse(row.dataset.host);

            if (host._id === targetId) {
              openHostSidebar(host);
              row.scrollIntoView({
                behavior: 'smooth',
                block: 'center'
              });
              break;
            }
          } catch (e) {
            console.error(e);
          }
        }
      })();
    </script>
    <%- include("partials/footer") %>
  </body>
</html>